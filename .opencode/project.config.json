{
  "$schema": "./.opencode/state/project.config.schema.json",
  "project": {
    "name": "booking-system",
    "description": "Appointment booking system with NestJS backend and Angular frontend",
    "version": "1.0.0"
  },
  "project_root": ".",
  "paths": {
    "backend_src": "booking-backend/src/",
    "frontend_src": "booking-frontend/",
    "contracts": "contract.yaml",
    "requirements": ".opencode/context/requirements/",
    "code_standards": ".opencode/context/code_standards/",
    "tests": "booking-backend/test/",
    "state": ".opencode/state/"
  },
  "tech_stack": {
    "backend": {
      "framework": "NestJS",
      "version": "11+",
      "runtime": "Node.js 22.x",
      "language": "TypeScript 5.x",
      "context7_query": "NestJS controller service module best practices",
      "context7_library": "/nestjs/nest"
    },
    "frontend": {
      "framework": "Angular",
      "version": "21+",
      "language": "TypeScript 5.x",
      "state_management": "NgRx SignalStore",
      "ui_library": "PrimeNG",
      "css": "Tailwind CSS v4",
      "context7_query": "Angular standalone component signal store",
      "context7_library": "/angular/angular"
    },
    "database": {
      "orm": "Prisma",
      "version": "7.x",
      "engine": "PostgreSQL 16",
      "context7_query": "Prisma transactions relations",
      "context7_library": "/prisma/prisma"
    },
    "cache": {
      "engine": "Redis 7.x",
      "client": "ioredis",
      "context7_query": "Redis cache pattern ioredis",
      "context7_library": "/redis/ioredis"
    },
    "queue": "BullMQ",
    "auth": {
      "mechanism": "JWT + Passport",
      "token_validity": "15m",
      "refresh_validity": "7d"
    },
    "testing": {
      "unit": "Jest 29+",
      "e2e": "Playwright",
      "integration": "Supertest + Testcontainers",
      "coverage_threshold": 80
    },
    "ci_cd": "GitHub Actions",
    "container": "Docker Compose v2"
  },
  "template_resolution": {
    "contract_hash_command": "node .opencode/scripts/mcp-tools/keystone-validate.js --hash contract.yaml",
    "backend.orm.schema": "prisma/schema.prisma",
    "frontend.dto_path": "src/app/shared/dto/",
    "frontend.env_path": "src/environments/environment.ts",
    "cache.engine": "Redis 7.x",
    "cache.client": "ioredis",
    "queue.engine": "BullMQ"
  },
  "context7_task_mapping": [
    {
      "agent": "@Coder-BE",
      "keywords": [
        "backend",
        "api",
        "controller",
        "service",
        "database",
        "prisma",
        "nest",
        "endpoint",
        "module",
        "auth",
        "jwt",
        "redis",
        "cache",
        "queue",
        "rate limit"
      ],
      "stacks": ["backend", "database", "cache"],
      "priority": 1
    },
    {
      "agent": "@Coder-FE",
      "keywords": [
        "frontend",
        "component",
        "page",
        "ui",
        "angular",
        "signal",
        "store",
        "style",
        "tailwind",
        "primeng",
        "routing",
        "guard"
      ],
      "stacks": ["frontend"],
      "priority": 1
    },
    {
      "agent": "@Architect",
      "keywords": [
        "architecture",
        "design",
        "contract",
        "schema",
        "api design",
        "database design",
        "module",
        "interface"
      ],
      "stacks": ["backend", "frontend", "database"],
      "priority": 1
    },
    {
      "agent": "@Guardian",
      "keywords": [
        "review",
        "audit",
        "security",
        "lint",
        "quality",
        "eslint",
        "tdd"
      ],
      "stacks": ["backend", "frontend"],
      "priority": 2
    },
    {
      "agent": "@CI-CD-Agent",
      "keywords": [
        "deploy",
        "docker",
        "ci",
        "cd",
        "pipeline",
        "container",
        "build",
        "release",
        "migrate"
      ],
      "stacks": ["backend", "frontend"],
      "priority": 2
    }
  ],
  "agent_write_scopes": {
    "@Coder-BE": {
      "allowed": [
        "booking-backend/src/**",
        "booking-backend/test/**",
        "booking-backend/prisma/**",
        "booking-backend/*.{json,js,ts}",
        ".task_temp/**",
        "contract.yaml"
      ],
      "denied": [
        "booking-frontend/**",
        ".opencode/agents/**",
        ".opencode/rules/**",
        ".opencode/tools/**",
        ".opencode/state/**",
        ".opencode/scripts/**",
        "AGENTS.md",
        "PROJECT_REFERENCE.md",
        "TECH_DEBT_REGISTRY.md"
      ]
    },
    "@Coder-FE": {
      "allowed": ["booking-frontend/**", ".task_temp/**", "contract.yaml"],
      "denied": [
        "booking-backend/**",
        ".opencode/agents/**",
        ".opencode/rules/**",
        ".opencode/tools/**",
        ".opencode/state/**",
        ".opencode/scripts/**",
        "AGENTS.md",
        "PROJECT_REFERENCE.md",
        "TECH_DEBT_REGISTRY.md"
      ]
    },
    "@Architect": {
      "allowed": [
        ".opencode/state/**",
        "contract.yaml",
        ".task_temp/**",
        ".opencode/project.config.json",
        "PROJECT_REFERENCE.md",
        ".opencode/context/**",
        ".opencode/rules/**",
        ".opencode/agents/**",
        ".opencode/subagent-preamble.md",
        ".opencode/scripts/**"
      ],
      "denied": [
        "booking-backend/src/**",
        "booking-frontend/src/**",
        "booking-backend/test/**"
      ]
    },
    "@Meta-Planner": {
      "allowed": [".task_temp/**", "Task.DAG.json", "Project.graph"],
      "denied": [
        "booking-backend/src/**",
        "booking-frontend/src/**",
        ".opencode/tools/**",
        ".opencode/scripts/**",
        ".opencode/state/**",
        "contract.yaml"
      ]
    },
    "@Orchestrator": {
      "allowed": [".task_temp/**", "Task.DAG.json"],
      "denied": [
        "booking-backend/src/**",
        "booking-frontend/src/**",
        "contract.yaml",
        ".opencode/tools/**",
        ".opencode/scripts/**"
      ]
    },
    "@Guardian": {
      "allowed": [".task_temp/**"],
      "denied": [
        "booking-backend/src/**",
        "booking-frontend/src/**",
        "contract.yaml",
        ".opencode/**",
        "AGENTS.md",
        "PROJECT_REFERENCE.md"
      ]
    },
    "@Arbiter": {
      "allowed": [".task_temp/**", "WAIVE.md", "TECH_DEBT_REGISTRY.md"],
      "denied": [
        "booking-backend/src/**",
        "booking-frontend/src/**",
        "contract.yaml",
        ".opencode/tools/**",
        ".opencode/scripts/**"
      ]
    },
    "@CI-CD-Agent": {
      "allowed": [
        "docker-compose*.yml",
        ".github/workflows/**",
        "Dockerfile*",
        ".env.*",
        "booking-backend/prisma/**",
        ".task_temp/**"
      ],
      "denied": [
        "booking-backend/src/**",
        "booking-frontend/src/**",
        ".opencode/agents/**",
        ".opencode/rules/**"
      ]
    }
  }
}

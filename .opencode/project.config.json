  "path_lint": {
    "$description": "Absolute path leakage detection configuration. Used by Check 19 in framework-self-test.js and path-canonical-lint.sh.",
    "scan_roots": [
      ".opencode/",
      "."
    ],
    "file_extensions": [
      ".md",
      ".json",
      ".yaml",
      ".yml",
      ".sh",
      ".js",
      ".ts"
    ],
    "leak_patterns": [
      {
        "name": "Linux home",
        "pattern": "/home/"
      },
      {
        "name": "macOS home",
        "pattern": "/Users/"
      },
      {
        "name": "root user",
        "pattern": "/root/"
      },
      {
        "name": "Windows absolute",
        "pattern": "[A-Za-z]:\\\\"
      }
    ],
    "whitelist": {
      "approved_absolute_paths": [
        "/tmp/opencode",
        "/usr/bin/"
      ],
      "template_patterns": [
        "{\\w+}",
        "\\$\\{"
      ],
      "url_patterns": [
        "https?://",
        "ftp://"
      ],
      "skip_directories": [
        ".opencode/state/"
      ]
    },
    "suggestion_templates": {
      "project_root_match": "{project_root}/<relative> OR ./<relative>",
      "github_runner_match": "${GITHUB_WORKSPACE}/<relative> OR ./<relative>",
      "generic_home_match": "Consider replacing with {project_root}/... or a repo-relative path",
      "windows_drive_match": "Consider replacing with a repo-relative path (./...)",
      "tmp_not_opencode": "Consider using /tmp/opencode/ (approved) or $TMPDIR",
      "fallback": "Consider replacing with a repo-relative path or {placeholder}"
    }
  },
  "agent_tool_scopes": {
    "$description": "UC7KS knowledge pipeline tool permissions per agent. Controls which agents may use external documentation tools (webfetch, websearch, context7_*). Enforced by uc7ks-enforcer.ts plugin and framework-enforcer.ts. Values: 'allow' (direct access), 'via_curator' (must route through @Knowledge-Curator in strict+ modes), 'deny' (never allowed).",
    "@Knowledge-Curator": {
      "doc_tools": "allow",
      "reason": "Designated knowledge curator — must fetch external docs to populate local cache"
    },
    "@Super-Admin": {
      "doc_tools": "via_curator",
      "reason": "Emergency framework admin — should follow UC7KS pipeline; bypass only in advisory mode"
    },
    "@Coder-BE": {
      "doc_tools": "via_curator",
      "reason": "Backend developer — external docs must be cached by @Knowledge-Curator first"
    },
    "@Coder-FE": {
      "doc_tools": "via_curator",
      "reason": "Frontend developer — external docs must be cached by @Knowledge-Curator first"
    },
    "@Architect": {
      "doc_tools": "via_curator",
      "reason": "System architect — external docs must be cached by @Knowledge-Curator first"
    },
    "@Meta-Planner": {
      "doc_tools": "via_curator",
      "reason": "Project CTO — external docs must be cached by @Knowledge-Curator first"
    },
    "@Orchestrator": {
      "doc_tools": "via_curator",
      "reason": "Project manager — should dispatch @Knowledge-Curator rather than query directly"
    },
    "@Guardian": {
      "doc_tools": "deny",
      "reason": "Quality gate — read-only; uses cached rules and standards only"
    },
    "@Arbiter": {
      "doc_tools": "deny",
      "reason": "Technical committee — reads cached rules and standards only"
    },
    "@CI-CD-Agent": {
      "doc_tools": "via_curator",
      "reason": "DevOps/SRE — deployment docs should be cached by @Knowledge-Curator first"
    }
  },

{
  "$schema": "./project.schema.json",
  "meta": {
    "version": "1.0.0",
    "description": "Multi-agent framework project configuration — customize for your project"
  },
  "project": {
    "name": "booking_system_refactor",
    "description": "Appointment booking system (NestJS + Angular)"
  },
  "project_root": "booking_system_refactor",
  "paths": {
    "backend_src": "booking-backend/src/",
    "frontend_src": "booking-frontend/src/",
    "contracts": "contract.yaml",
    "node_modules_hint": "node_modules",
    "mcp_gate_script": ".opencode/scripts/mcp-tools/compliance-gate.js"
  },
  "tech_stack": {
    "backend": {
      "name": "NestJS v11+ / Node.js 22 LTS",
      "context7_query": "nestjs"
    },
    "database": {
      "name": "Prisma 7.x + PostgreSQL 16",
      "context7_query": "prisma"
    },
    "cache": {
      "name": "Redis 7.x + BullMQ",
      "context7_query": "redis"
    },
    "frontend": {
      "name": "Angular v21+ / PrimeNG / Tailwind CSS v4 / NgRx Signals",
      "context7_query": "angular"
    },
    "auth": {
      "name": "JWT + Passport / helmet / CSRF",
      "context7_query": "passport"
    },
    "testing": {
      "name": "Jest + Angular Testing Library / Playwright / Testcontainers / k6 + Lighthouse",
      "context7_query": "jest"
    },
    "ci_cd": {
      "name": "Docker + Docker Compose / GitHub Actions / PgBouncer",
      "context7_query": "docker"
    }
  },
  "context7_task_mapping": [
    {
      "keywords": ["backend", "api", "service", "controller", "dto", "guard", "interceptor", "pipe", "decorator", "module", "provider"],
      "stacks": ["backend", "database"]
    },
    {
      "keywords": ["prisma", "migration", "migrate", "seed", "schema", "entity", "model", "orm"],
      "stacks": ["database"]
    },
    {
      "keywords": ["redis", "bullmq", "cache", "queue", "message", "lock", "distributed", "preempt", "concurrency"],
      "stacks": ["cache"]
    },
    {
      "keywords": ["jwt", "passport", "auth", "token", "refresh", "login", "register", "session", "helmet", "csrf"],
      "stacks": ["auth", "backend"]
    },
    {
      "keywords": ["frontend", "ui", "component", "page", "route", "style", "template", "html", "scss", "css", "layout", "prime", "tailwind"],
      "stacks": ["frontend"]
    },
    {
      "keywords": ["ngrx", "signalstore", "signal", "selector", "effect", "state", "store"],
      "stacks": ["frontend"]
    },
    {
      "keywords": ["test", "coverage", "spec", "e2e", "unit", "integration", "mock", "stryker", "lighthouse", "testcontainers", "k6"],
      "stacks": ["testing"]
    },
    {
      "keywords": ["ci", "cd", "deploy", "docker", "workflow", "action", "pipeline", "container", "pgbouncer", "compose"],
      "stacks": ["ci_cd"]
    }
  ]
}

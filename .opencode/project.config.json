{
  "$schema": "./.opencode/state/project.config.schema.json",
  "project": {
    "name": "booking-system",
    "description": "Appointment booking system with NestJS backend and Angular frontend",
    "version": "1.0.0"
  },
  "project_root": ".",
  "paths": {
    "backend_src": "booking_system_refactor/booking-backend/src/",
    "frontend_src": "booking_system_refactor/booking-frontend/",
    "contracts": "contract.yaml",
    "requirements": ".opencode/context/requirements/",
    "code_standards": ".opencode/context/code_standards/",
    "tests": "booking_system_refactor/booking-backend/test/",
    "state": ".opencode/state/",
    "knowledge_docs": "docs/official_docs/",
    "knowledge_index": "docs/official_docs/index.json"
  },
  "tech_stack": {
    "backend": {
      "framework": "NestJS",
      "version": "11+",
      "runtime": "Node.js 22.x",
      "language": "TypeScript 5.x",
      "context7_query": "NestJS controller service module best practices",
      "context7_library": "/nestjs/nest"
    },
    "frontend": {
      "framework": "Angular",
      "version": "21+",
      "language": "TypeScript 5.x",
      "state_management": "NgRx SignalStore",
      "ui_library": "PrimeNG",
      "css": "Tailwind CSS v4",
      "context7_query": "Angular standalone component signal store",
      "context7_library": "/angular/angular"
    },
    "database": {
      "orm": "Prisma",
      "version": "7.x",
      "engine": "PostgreSQL 16",
      "context7_query": "Prisma transactions relations",
      "context7_library": "/prisma/prisma"
    },
    "cache": {
      "engine": "Redis 7.x",
      "client": "ioredis",
      "context7_query": "Redis cache pattern ioredis",
      "context7_library": "/redis/ioredis"
    },
    "queue": "BullMQ",
    "auth": {
      "mechanism": "JWT + Passport",
      "token_validity": "15m",
      "refresh_validity": "7d"
    },
    "testing": {
      "unit": "Jest 29+",
      "e2e": "Playwright",
      "integration": "Supertest + Testcontainers",
      "coverage_threshold": 80
    },
    "ci_cd": "GitHub Actions",
    "container": "Docker Compose v2"
  },
  "template_resolution": {
    "develop_enforcement_mode": "advisory",
    "runtime_enforcement_mode": "advisory",
    "compatibility_profile": "native",
    "enforcement_config": {
      "advisory": {
        "description": "Warnings only, non-blocking. Suitable for local development.",
        "block_on": [],
        "log_level": "warn"
      },
      "strict": {
        "description": "Blocks non-compliant actions. Suitable for CI/staging. UC7KS pipeline enforced: external doc queries blocked if local cache exists but not searched.",
        "block_on": [
          "gate_armed",
          "keystone_hash",
          "tdd_order",
          "dag_gate",
          "eslint_audit",
          "role_scope",
          "uc7ks_pipeline"
        ],
        "log_level": "error"
      },
      "locked": {
        "description": "Prevents all changes without governance override. ALL external doc queries blocked — only @Knowledge-Curator may fetch docs. Suitable for production config branches.",
        "block_on": [
          "gate_armed",
          "keystone_hash",
          "keystone_integrity",
          "tdd_order",
          "dag_gate",
          "eslint_audit",
          "role_scope",
          "workspace_root",
          "gate_state_sync",
          "write_audit_integrity",
          "uc7ks_pipeline"
        ],
        "log_level": "error",
        "allow_waivers": false,
        "allow_downgrade": false
      }
    },
    "contract_hash_command": "bun .opencode/scripts/mcp-tools/keystone-validate.ts --hash contract.yaml",
    "backend.src": "booking_system_refactor/booking-backend/src/",
    "backend.framework": "NestJS",
    "backend.runtime": "Node.js 22.x",
    "backend.language": "TypeScript 5.x",
    "backend.orm.schema": "booking_system_refactor/booking-backend/prisma/schema.prisma",
    "backend.orm.transaction": "Prisma $transaction() with interactive transactions",
    "backend.auth": "JWT + Passport with @Roles() and @SkipAuth() decorators",
    "backend.rate_limit": "NestJS ThrottlerModule: 15/min auth, 60/min admin, 120/min health",
    "backend.error_handler": "Global ExceptionFilter + PrismaExceptionFilter, unified ResponseDto envelope",
    "backend.logger": "NestJS Logger with request interceptor (method, URL, status, duration)",
    "backend.api_docs": "Swagger/OpenAPI via @nestjs/swagger with @ApiProperty decorators",
    "backend.cache_pattern": "Redis 7.x + ioredis, cache-aside pattern (TTL 300s)",
    "frontend.src": "booking_system_refactor/booking-frontend/",
    "frontend.framework": "Angular 21+",
    "frontend.state_management": "NgRx SignalStore",
    "frontend.ui_library": "PrimeNG",
    "frontend.css": "Tailwind CSS v4",
    "frontend.dto_path": "src/app/shared/dto/",
    "frontend.env_path": "src/environments/environment.ts",
    "frontend.css_strategy": "Tailwind CSS v4 First; SCSS for complex animations; BEM naming for private styles",
    "frontend.state_pattern": "NgRx SignalStore: signalStore() + withState() + withComputed() + withMethods()",
    "frontend.component_hierarchy": "Atomic Design: Atoms \u2192 Molecules \u2192 Organisms \u2192 Layouts \u2192 Pages",
    "frontend.lazy_loading": "Angular loadChildren/loadComponent + @defer(on viewport)",
    "frontend.api_pattern": "Service encapsulation + DTO alignment; HttpClient forbidden in components",
    "cache.engine": "Redis 7.x",
    "cache.client": "ioredis",
    "queue.engine": "BullMQ",
    "knowledge.max_file_size": 524288,
    "knowledge.max_total_size": 52428800,
    "knowledge.default_ttl": 30,
    "knowledge.fallback_ttl": 14,
    "knowledge.opencode_ttl": 7,
    "knowledge.scout_ttl": 14,
    "knowledge.janitor_interval_hours": 24,
    "knowledge.compression_threshold_kb": 200,
    "knowledge.fallback_url_nestjs": "https://docs.nestjs.com/{topic}",
    "knowledge.fallback_url_prisma": "https://www.prisma.io/docs/{topic}",
    "knowledge.fallback_url_angular": "https://angular.dev/{topic}",
    "knowledge.fallback_url_redis": "https://redis.io/docs/{topic}",
    "knowledge.fallback_url_bullmq": "https://docs.bullmq.io/{topic}",
    "knowledge.fallback_url_jest": "https://jestjs.io/docs/{topic}",
    "knowledge.fallback_url_jwt": "https://jwt.io/introduction",
    "knowledge.fallback_url_eslint": "https://eslint.org/docs/{topic}",
    "knowledge.fallback_url_docker": "https://docs.docker.com/{topic}",
    "knowledge.fallback_url_opencode": "https://opencode.ai/docs/{topic}",
    "knowledge.fallback_url_git": "https://git-scm.com/docs/{topic}"
  },
  "context7_task_mapping": [
    {
      "agent": "@Coder-BE",
      "keywords": [
        "backend",
        "api",
        "controller",
        "service",
        "database",
        "prisma",
        "nest",
        "endpoint",
        "module",
        "auth",
        "jwt",
        "redis",
        "cache",
        "queue",
        "rate limit"
      ],
      "stacks": [
        "backend",
        "database",
        "cache"
      ],
      "priority": 1
    },
    {
      "agent": "@Coder-FE",
      "keywords": [
        "frontend",
        "component",
        "page",
        "ui",
        "angular",
        "signal",
        "store",
        "style",
        "tailwind",
        "primeng",
        "routing",
        "guard"
      ],
      "stacks": [
        "frontend"
      ],
      "priority": 1
    },
    {
      "agent": "@Architect",
      "keywords": [
        "architecture",
        "design",
        "contract",
        "schema",
        "api design",
        "database design",
        "module",
        "interface"
      ],
      "stacks": [
        "backend",
        "frontend",
        "database"
      ],
      "priority": 1
    },
    {
      "agent": "@Guardian",
      "keywords": [
        "review",
        "audit",
        "security",
        "lint",
        "quality",
        "eslint",
        "tdd"
      ],
      "stacks": [
        "backend",
        "frontend"
      ],
      "priority": 2
    },
    {
      "agent": "@CI-CD-Agent",
      "keywords": [
        "deploy",
        "docker",
        "ci",
        "cd",
        "pipeline",
        "container",
        "build",
        "release",
        "migrate"
      ],
      "stacks": [
        "backend",
        "frontend"
      ],
      "priority": 2
    }
  ],
  "knowledge_semantic_map": {
    "domains": [
      {
        "domain_id": "backend_api",
        "keywords": ["controller", "endpoint", "guard", "middleware", "swagger", "dto", "api", "service", "module", "interceptor", "pipe", "filter", "provider", "decorator"],
        "context7_libraries": ["{backend.framework}"],
        "fallback_pattern": "https://docs.nestjs.com/{topic}",
        "save_path": "backend/nestjs/",
        "ttl_days": 30
      },
      {
        "domain_id": "persistence",
        "keywords": ["database", "prisma", "schema", "migration", "transaction", "sql", "orm", "seed", "model", "relation"],
        "context7_libraries": ["{db.orm}"],
        "fallback_pattern": "https://www.prisma.io/docs/{topic}",
        "save_path": "backend/prisma/",
        "ttl_days": 30
      },
      {
        "domain_id": "frontend_ui",
        "keywords": ["component", "template", "signal", "store", "style", "css", "tailwind", "angular", "primeng", "routing", "lazy", "defer", "directive", "pipe"],
        "context7_libraries": ["{frontend.framework}", "{frontend.ui_library}"],
        "fallback_pattern": "https://angular.dev/{topic}",
        "save_path": "frontend/angular/",
        "ttl_days": 30
      },
      {
        "domain_id": "caching",
        "keywords": ["cache", "redis", "ioredis", "ttl", "cache-aside", "cache-pattern"],
        "context7_libraries": ["{cache.engine}"],
        "fallback_pattern": "https://redis.io/docs/{topic}",
        "save_path": "database/redis/",
        "ttl_days": 30
      },
      {
        "domain_id": "queue",
        "keywords": ["queue", "bullmq", "job", "worker", "scheduler", "message-queue"],
        "context7_libraries": ["{queue.engine}"],
        "fallback_pattern": "https://docs.bullmq.io/{topic}",
        "save_path": "devops/bullmq/",
        "ttl_days": 30
      },
      {
        "domain_id": "testing",
        "keywords": ["test", "jest", "spec", "coverage", "e2e", "playwright", "supertest", "mock", "stub", "spy", "assert"],
        "context7_libraries": ["{testing.unit}", "{testing.e2e}"],
        "fallback_pattern": "https://jestjs.io/docs/{topic}",
        "save_path": "devops/testing/",
        "ttl_days": 30
      },
      {
        "domain_id": "auth_security",
        "keywords": ["auth", "jwt", "passport", "oauth", "guard", "token", "refresh", "csrf", "rate-limit", "helmet", "roles"],
        "context7_libraries": ["{auth.mechanism}"],
        "fallback_pattern": "https://jwt.io/introduction",
        "save_path": "backend/auth/",
        "ttl_days": 30
      },
      {
        "domain_id": "framework_tools",
        "keywords": ["eslint", "prettier", "typescript", "hook", "plugin", "config", "linter", "formatter", "tsc", "tsconfig"],
        "context7_libraries": ["/eslint/eslint", "/typescript/typescript"],
        "fallback_pattern": "https://eslint.org/docs/{topic}",
        "save_path": "framework/eslint/",
        "ttl_days": 30
      },
      {
        "domain_id": "devops_ci",
        "keywords": ["docker", "compose", "github-actions", "ci", "cd", "pipeline", "deploy", "workflow", "container", "image"],
        "context7_libraries": ["/docker/docker", "/github/github"],
        "fallback_pattern": "https://docs.docker.com/{topic}",
        "save_path": "devops/docker/",
        "ttl_days": 30
      },
      {
        "domain_id": "opencode_framework",
        "keywords": ["opencode", "agent", "skill", "mcp", "framework", "compliance", "gate", "orchestrator", "dispatch", "subagent", "permission", "plugin", "config"],
        "context7_libraries": [],
        "fallback_pattern": "https://opencode.ai/docs/{topic}",
        "save_path": "opencode/framework/",
        "ttl_days": 7
      },
      {
        "domain_id": "infrastructure",
        "keywords": ["git", "json-schema", "nodejs", "markdown", "yaml", "pandoc", "shell", "bash", "npm", "npx"],
        "context7_libraries": ["/git/git"],
        "fallback_pattern": "https://git-scm.com/docs/{topic}",
        "save_path": "framework/git/",
        "ttl_days": 30
      }
    ]
  },
  "path_lint": {
    "$description": "Absolute path leakage detection configuration. Used by Check 19 in framework-self-test.js and path-canonical-lint.sh.",
    "scan_roots": [
      ".opencode/",
      "."
    ],
    "file_extensions": [
      ".md",
      ".json",
      ".yaml",
      ".yml",
      ".sh",
      ".js",
      ".ts"
    ],
    "leak_patterns": [
      {
        "name": "Linux home",
        "pattern": "/home/"
      },
      {
        "name": "macOS home",
        "pattern": "/Users/"
      },
      {
        "name": "root user",
        "pattern": "/root/"
      },
      {
        "name": "Windows absolute",
        "pattern": "[A-Za-z]:\\\\"
      }
    ],
    "whitelist": {
      "approved_absolute_paths": [
        "/tmp/opencode",
        "/usr/bin/"
      ],
      "template_patterns": [
        "{\\w+}",
        "\\$\\{"
      ],
      "url_patterns": [
        "https?://",
        "ftp://"
      ],
      "skip_directories": [
        ".opencode/state/"
      ]
    },
    "suggestion_templates": {
      "project_root_match": "{project_root}/<relative> OR ./<relative>",
      "github_runner_match": "${GITHUB_WORKSPACE}/<relative> OR ./<relative>",
      "generic_home_match": "Consider replacing with {project_root}/... or a repo-relative path",
      "windows_drive_match": "Consider replacing with a repo-relative path (./...)",
      "tmp_not_opencode": "Consider using /tmp/opencode/ (approved) or $TMPDIR",
      "fallback": "Consider replacing with a repo-relative path or {placeholder}"
    }
  },
  "agent_tool_scopes": {
    "$description": "UC7KS knowledge pipeline tool permissions per agent. Controls which agents may use external documentation tools (webfetch, websearch, context7_*). Enforced by uc7ks-enforcer.ts plugin and framework-enforcer.ts. Values: 'allow' (direct access), 'via_curator' (must route through @Knowledge-Curator in strict+ modes), 'deny' (never allowed).",
    "@Knowledge-Curator": {
      "doc_tools": "allow",
      "reason": "Designated knowledge curator — must fetch external docs to populate local cache"
    },
    "@Super-Admin": {
      "doc_tools": "via_curator",
      "reason": "Emergency framework admin — should follow UC7KS pipeline; bypass only in advisory mode"
    },
    "@Coder-BE": {
      "doc_tools": "via_curator",
      "reason": "Backend developer — external docs must be cached by @Knowledge-Curator first"
    },
    "@Coder-FE": {
      "doc_tools": "via_curator",
      "reason": "Frontend developer — external docs must be cached by @Knowledge-Curator first"
    },
    "@Architect": {
      "doc_tools": "via_curator",
      "reason": "System architect — external docs must be cached by @Knowledge-Curator first"
    },
    "@Meta-Planner": {
      "doc_tools": "via_curator",
      "reason": "Project CTO — external docs must be cached by @Knowledge-Curator first"
    },
    "@Orchestrator": {
      "doc_tools": "via_curator",
      "reason": "Project manager — should dispatch @Knowledge-Curator rather than query directly"
    },
    "@Guardian": {
      "doc_tools": "deny",
      "reason": "Quality gate — read-only; uses cached rules and standards only"
    },
    "@Arbiter": {
      "doc_tools": "deny",
      "reason": "Technical committee — reads cached rules and standards only"
    },
    "@CI-CD-Agent": {
      "doc_tools": "via_curator",
      "reason": "DevOps/SRE — deployment docs should be cached by @Knowledge-Curator first"
    }
  },
  "agent_write_scopes": {
    "@Coder-BE": {

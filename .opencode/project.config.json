{
  "$schema": "./.opencode/state/project.config.schema.json",
  "project": {
    "name": "booking-system",
    "description": "Appointment booking system with NestJS backend and Angular frontend",
    "version": "1.0.0"
  },
  "project_root": ".",
  "paths": {
    "backend_src": "booking_system_refactor/booking-backend/src/",
    "frontend_src": "booking_system_refactor/booking-frontend/",
    "contracts": "contract.yaml",
    "requirements": ".opencode/context/requirements/",
    "code_standards": ".opencode/context/code_standards/",
    "tests": "booking_system_refactor/booking-backend/test/",
    "state": ".opencode/state/"
  },
  "tech_stack": {
    "backend": {
      "framework": "NestJS",
      "version": "11+",
      "runtime": "Node.js 22.x",
      "language": "TypeScript 5.x",
      "context7_query": "NestJS controller service module best practices",
      "context7_library": "/nestjs/nest"
    },
    "frontend": {
      "framework": "Angular",
      "version": "21+",
      "language": "TypeScript 5.x",
      "state_management": "NgRx SignalStore",
      "ui_library": "PrimeNG",
      "css": "Tailwind CSS v4",
      "context7_query": "Angular standalone component signal store",
      "context7_library": "/angular/angular"
    },
    "database": {
      "orm": "Prisma",
      "version": "7.x",
      "engine": "PostgreSQL 16",
      "context7_query": "Prisma transactions relations",
      "context7_library": "/prisma/prisma"
    },
    "cache": {
      "engine": "Redis 7.x",
      "client": "ioredis",
      "context7_query": "Redis cache pattern ioredis",
      "context7_library": "/redis/ioredis"
    },
    "queue": "BullMQ",
    "auth": {
      "mechanism": "JWT + Passport",
      "token_validity": "15m",
      "refresh_validity": "7d"
    },
    "testing": {
      "unit": "Jest 29+",
      "e2e": "Playwright",
      "integration": "Supertest + Testcontainers",
      "coverage_threshold": 80
    },
    "ci_cd": "GitHub Actions",
    "container": "Docker Compose v2"
  },
  "template_resolution": {
    "enforcement_mode": "strict",
    "compatibility_profile": "native",
    "enforcement_config": {
      "advisory": {
        "description": "Warnings only, non-blocking. Suitable for local development.",
        "block_on": [],
        "log_level": "warn"
      },
      "strict": {
        "description": "Blocks non-compliant actions. Suitable for CI/staging.",
        "block_on": [
          "gate_armed",
          "keystone_hash",
          "tdd_order",
          "dag_gate",
          "eslint_audit",
          "role_scope"
        ],
        "log_level": "error"
      },
      "locked": {
        "description": "Prevents all changes without governance override. Suitable for production config branches.",
        "block_on": [
          "gate_armed",
          "keystone_hash",
          "keystone_integrity",
          "tdd_order",
          "dag_gate",
          "eslint_audit",
          "role_scope",
          "workspace_root",
          "gate_state_sync",
          "write_audit_integrity"
        ],
        "log_level": "error",
        "allow_waivers": false,
        "allow_downgrade": false
      }
    },
    "contract_hash_command": "node .opencode/scripts/mcp-tools/keystone-validate.js --hash contract.yaml",
    "backend.src": "booking_system_refactor/booking-backend/src/",
    "backend.framework": "NestJS",
    "backend.runtime": "Node.js 22.x",
    "backend.language": "TypeScript 5.x",
    "backend.orm.schema": "booking_system_refactor/booking-backend/prisma/schema.prisma",
    "backend.orm.transaction": "Prisma $transaction() with interactive transactions",
    "backend.auth": "JWT + Passport with @Roles() and @SkipAuth() decorators",
    "backend.rate_limit": "NestJS ThrottlerModule: 15/min auth, 60/min admin, 120/min health",
    "backend.error_handler": "Global ExceptionFilter + PrismaExceptionFilter, unified ResponseDto envelope",
    "backend.logger": "NestJS Logger with request interceptor (method, URL, status, duration)",
    "backend.api_docs": "Swagger/OpenAPI via @nestjs/swagger with @ApiProperty decorators",
    "backend.cache_pattern": "Redis 7.x + ioredis, cache-aside pattern (TTL 300s)",
    "frontend.src": "booking_system_refactor/booking-frontend/",
    "frontend.framework": "Angular 21+",
    "frontend.state_management": "NgRx SignalStore",
    "frontend.ui_library": "PrimeNG",
    "frontend.css": "Tailwind CSS v4",
    "frontend.dto_path": "src/app/shared/dto/",
    "frontend.env_path": "src/environments/environment.ts",
    "frontend.css_strategy": "Tailwind CSS v4 First; SCSS for complex animations; BEM naming for private styles",
    "frontend.state_pattern": "NgRx SignalStore: signalStore() + withState() + withComputed() + withMethods()",
    "frontend.component_hierarchy": "Atomic Design: Atoms → Molecules → Organisms → Layouts → Pages",
    "frontend.lazy_loading": "Angular loadChildren/loadComponent + @defer(on viewport)",
    "frontend.api_pattern": "Service encapsulation + DTO alignment; HttpClient forbidden in components",
    "cache.engine": "Redis 7.x",
    "cache.client": "ioredis",
    "queue.engine": "BullMQ"
  },
  "context7_task_mapping": [
    {
      "agent": "@Coder-BE",
      "keywords": [
        "backend",
        "api",
        "controller",
        "service",
        "database",
        "prisma",
        "nest",
        "endpoint",
        "module",
        "auth",
        "jwt",
        "redis",
        "cache",
        "queue",
        "rate limit"
      ],
      "stacks": ["backend", "database", "cache"],
      "priority": 1
    },
    {
      "agent": "@Coder-FE",
      "keywords": [
        "frontend",
        "component",
        "page",
        "ui",
        "angular",
        "signal",
        "store",
        "style",
        "tailwind",
        "primeng",
        "routing",
        "guard"
      ],
      "stacks": ["frontend"],
      "priority": 1
    },
    {
      "agent": "@Architect",
      "keywords": [
        "architecture",
        "design",
        "contract",
        "schema",
        "api design",
        "database design",
        "module",
        "interface"
      ],
      "stacks": ["backend", "frontend", "database"],
      "priority": 1
    },
    {
      "agent": "@Guardian",
      "keywords": [
        "review",
        "audit",
        "security",
        "lint",
        "quality",
        "eslint",
        "tdd"
      ],
      "stacks": ["backend", "frontend"],
      "priority": 2
    },
    {
      "agent": "@CI-CD-Agent",
      "keywords": [
        "deploy",
        "docker",
        "ci",
        "cd",
        "pipeline",
        "container",
        "build",
        "release",
        "migrate"
      ],
      "stacks": ["backend", "frontend"],
      "priority": 2
    }
  ],
  "path_lint": {
    "$description": "Absolute path leakage detection configuration. Used by Check 19 in framework-self-test.js and path-canonical-lint.sh.",
    "scan_roots": [".opencode/", "."],
    "file_extensions": [".md", ".json", ".yaml", ".yml", ".sh", ".js", ".ts"],
    "leak_patterns": [
      { "name": "Linux home", "pattern": "/home/" },
      { "name": "macOS home", "pattern": "/Users/" },
      { "name": "root user", "pattern": "/root/" },
      { "name": "Windows absolute", "pattern": "[A-Za-z]:\\\\" }
    ],
    "whitelist": {
      "approved_absolute_paths": ["/tmp/opencode", "/usr/bin/"],
      "template_patterns": ["{\\w+}", "\\$\\{"],
      "url_patterns": ["https?://", "ftp://"],
      "skip_directories": [".opencode/state/"]
    },
    "suggestion_templates": {
      "project_root_match": "{project_root}/<relative> OR ./<relative>",
      "github_runner_match": "${GITHUB_WORKSPACE}/<relative> OR ./<relative>",
      "generic_home_match": "Consider replacing with {project_root}/... or a repo-relative path",
      "windows_drive_match": "Consider replacing with a repo-relative path (./...)",
      "tmp_not_opencode": "Consider using /tmp/opencode/ (approved) or $TMPDIR",
      "fallback": "Consider replacing with a repo-relative path or {placeholder}"
    }
  },
  "agent_write_scopes": {
    "@Coder-BE": {
      "allowed": [
        "booking_system_refactor/booking-backend/src/**",
        "booking_system_refactor/booking-backend/test/**",
        "booking_system_refactor/booking-backend/prisma/**",
        "booking_system_refactor/booking-backend/*.{json,js,ts}",
        ".opencode/scripts/__tests__/**",
        ".task_temp/**",
        "contract.yaml"
      ],
      "denied": [
        "booking_system_refactor/booking-frontend/**",
        ".opencode/agents/**",
        ".opencode/rules/**",
        ".opencode/tools/**",
        ".opencode/state/**",
        ".opencode/scripts/mcp-tools/**",
        ".opencode/scripts/command-tools/**",
        "AGENTS.md",
        "PROJECT_REFERENCE.md",
        "TECH_DEBT_REGISTRY.md"
      ]
    },
    "@Coder-FE": {
      "allowed": [
        "booking_system_refactor/booking-frontend/**",
        ".task_temp/**",
        "contract.yaml"
      ],
      "denied": [
        "booking_system_refactor/booking-backend/**",
        ".opencode/agents/**",
        ".opencode/rules/**",
        ".opencode/tools/**",
        ".opencode/state/**",
        ".opencode/scripts/**",
        "AGENTS.md",
        "PROJECT_REFERENCE.md",
        "TECH_DEBT_REGISTRY.md"
      ]
    },
    "@Architect": {
      "allowed": [
        ".opencode/state/**",
        "contract.yaml",
        ".task_temp/**",
        ".opencode/project.config.json",
        "PROJECT_REFERENCE.md",
        ".opencode/context/**",
        ".opencode/rules/**",
        ".opencode/agents/**",
        ".opencode/subagent-preamble.md",
        ".opencode/scripts/**"
      ],
      "denied": [
        "booking_system_refactor/booking-backend/src/**",
        "booking_system_refactor/booking-frontend/src/**",
        "booking_system_refactor/booking-backend/test/**"
      ]
    },
    "@Meta-Planner": {
      "allowed": [".task_temp/**", "Task.DAG.json", "Project.graph"],
      "denied": [
        "booking_system_refactor/booking-backend/src/**",
        "booking_system_refactor/booking-frontend/src/**",
        ".opencode/tools/**",
        ".opencode/scripts/**",
        ".opencode/state/**",
        "contract.yaml"
      ]
    },
    "@Orchestrator": {
      "allowed": [".task_temp/**", "Task.DAG.json"],
      "denied": [
        "booking_system_refactor/booking-backend/src/**",
        "booking_system_refactor/booking-frontend/src/**",
        "contract.yaml",
        ".opencode/tools/**",
        ".opencode/scripts/**"
      ]
    },
    "@Guardian": {
      "allowed": [".task_temp/**"],
      "denied": [
        "booking_system_refactor/booking-backend/src/**",
        "booking_system_refactor/booking-frontend/src/**",
        "contract.yaml",
        ".opencode/**",
        "AGENTS.md",
        "PROJECT_REFERENCE.md"
      ]
    },
    "@Arbiter": {
      "allowed": [".task_temp/**", "WAIVE.md", "TECH_DEBT_REGISTRY.md"],
      "denied": [
        "booking_system_refactor/booking-backend/src/**",
        "booking_system_refactor/booking-frontend/src/**",
        "contract.yaml",
        ".opencode/tools/**",
        ".opencode/scripts/**"
      ]
    },
    "@CI-CD-Agent": {
      "allowed": [
        "docker-compose*.yml",
        ".github/workflows/**",
        "Dockerfile*",
        ".env.*",
        "booking_system_refactor/booking-backend/prisma/**",
        ".task_temp/**"
      ],
      "denied": [
        "booking_system_refactor/booking-backend/src/**",
        "booking_system_refactor/booking-frontend/src/**",
        ".opencode/agents/**",
        ".opencode/rules/**"
      ]
    }
  }
}

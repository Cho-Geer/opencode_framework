{
  "$schema": "./project.schema.json",
  "meta": {
    "version": "1.0.0",
    "description": "Multi-agent framework project configuration — customize for your project"
  },
  "project": {
    "name": "booking_system_refactor",
    "description": "Appointment booking system (NestJS + Angular)"
  },
  "project_root": "booking_system_refactor",
  "paths": {
    "backend_src": "booking-backend/src/",
    "frontend_src": "booking-frontend/src/",
    "contracts": "contract.yaml",
    "node_modules_hint": "node_modules",
    "mcp_gate_script": ".opencode/scripts/mcp-tools/compliance-gate.js",
    "mcp_keystone_script": ".opencode/scripts/mcp-tools/keystone-validate.js",
    "mcp_eslint_audit_script": ".opencode/scripts/mcp-tools/eslint-audit.js",
    "mcp_code_quality_gate_script": ".opencode/scripts/mcp-tools/code-quality-gate.js"
  },
  "tech_stack": {
    "backend": {
      "name": "NestJS v11+ / Node.js 22 LTS",
      "context7_query": "nestjs"
    },
    "database": {
      "name": "Prisma 7.x + PostgreSQL 16",
      "context7_query": "prisma"
    },
    "cache": {
      "name": "Redis 7.x + BullMQ",
      "context7_query": "redis"
    },
    "frontend": {
      "name": "Angular v21+ / PrimeNG / Tailwind CSS v4 / NgRx Signals",
      "context7_query": "angular"
    },
    "auth": {
      "name": "JWT + Passport / helmet / CSRF",
      "context7_query": "passport"
    },
    "testing": {
      "name": "Jest + Angular Testing Library / Playwright / Testcontainers / k6 + Lighthouse",
      "context7_query": "jest"
    },
    "ci_cd": {
      "name": "Docker + Docker Compose / GitHub Actions / PgBouncer",
      "context7_query": "docker"
    }
  },

  "agent_write_scopes": {
    "@Architect": {
      "allowed": [
        ".opencode/**/*",
        "booking_system_refactor/contract.yaml",
        "AGENTS.md",
        "**/*.md"
      ],
      "denied": [
        "booking_system_refactor/booking-backend/src/**",
        "booking_system_refactor/booking-frontend/src/**",
        "booking_system_refactor/e2e/**"
      ],
      "description": "Architect writes only architectural docs and contracts"
    },
    "@Coder-BE": {
      "allowed": [
        "booking_system_refactor/booking-backend/src/**",
        "booking_system_refactor/booking-backend/prisma/**",
        "booking_system_refactor/booking-backend/test/**"
      ],
      "denied": [
        "booking_system_refactor/contract.yaml",
        "booking_system_refactor/booking-frontend/**",
        ".opencode/**",
        "AGENTS.md"
      ],
      "description": "Coder-BE writes only backend code"
    },
    "@Coder-FE": {
      "allowed": [
        "booking_system_refactor/booking-frontend/src/**",
        "booking_system_refactor/e2e/**"
      ],
      "denied": [
        "booking_system_refactor/booking-backend/**",
        "booking_system_refactor/contract.yaml",
        ".opencode/**",
        "AGENTS.md"
      ],
      "description": "Coder-FE writes only frontend code and E2E tests"
    },
    "@Guardian": {
      "allowed": [".task_temp/**", ".opencode/state/**"],
      "denied": [
        "booking_system_refactor/booking-backend/**",
        "booking_system_refactor/booking-frontend/**",
        "booking_system_refactor/contract.yaml",
        "AGENTS.md"
      ],
      "description": "Guardian is read-only on business code, writes only review artifacts"
    },
    "@Meta-Planner": {
      "allowed": ["project.graph", "Task.DAG.json", ".task_temp/**"],
      "denied": [
        "booking_system_refactor/booking-backend/src/**",
        "booking_system_refactor/booking-frontend/src/**",
        "booking_system_refactor/contract.yaml",
        ".opencode/agents/*.md"
      ],
      "description": "Meta-Planner writes only planning documents"
    },
    "@Orchestrator": {
      "allowed": [".opencode/state/**", ".task_temp/**", "Task.DAG.json"],
      "denied": [
        "**/*.ts",
        "**/*.html",
        "**/*.scss",
        "booking_system_refactor/contract.yaml"
      ],
      "description": "Orchestrator writes only state management files"
    },
    "@Arbiter": {
      "allowed": [
        ".task_temp/**",
        "WAIVE.md",
        "OVERRIDE.md",
        "TECH_DEBT_REGISTRY.md"
      ],
      "denied": [
        "booking_system_refactor/booking-backend/**",
        "booking_system_refactor/booking-frontend/**",
        "booking_system_refactor/contract.yaml",
        "**/*.ts",
        "**/*.html"
      ],
      "description": "Arbiter writes only arbitration artifacts and tech-debt registry"
    },
    "@CI-CD-Agent": {
      "allowed": [
        ".github/**",
        "docker-compose*.yml",
        "Dockerfile*",
        "scripts/**",
        ".task_temp/**"
      ],
      "denied": [
        "booking_system_refactor/booking-backend/**",
        "booking_system_refactor/booking-frontend/**",
        "booking_system_refactor/contract.yaml",
        ".opencode/agents/**"
      ],
      "description": "CI-CD-Agent writes only CI/CD pipeline and deployment configuration"
    }
  },

  "context7_task_mapping": [
    {
      "keywords": [
        "backend",
        "api",
        "service",
        "controller",
        "dto",
        "guard",
        "interceptor",
        "pipe",
        "decorator",
        "module",
        "provider"
      ],
      "stacks": ["backend", "database"]
    },
    {
      "keywords": [
        "prisma",
        "migration",
        "migrate",
        "seed",
        "schema",
        "entity",
        "model",
        "orm"
      ],
      "stacks": ["database"]
    },
    {
      "keywords": [
        "redis",
        "bullmq",
        "cache",
        "queue",
        "message",
        "lock",
        "distributed",
        "preempt",
        "concurrency"
      ],
      "stacks": ["cache"]
    },
    {
      "keywords": [
        "jwt",
        "passport",
        "auth",
        "token",
        "refresh",
        "login",
        "register",
        "session",
        "helmet",
        "csrf"
      ],
      "stacks": ["auth", "backend"]
    },
    {
      "keywords": [
        "frontend",
        "ui",
        "component",
        "page",
        "route",
        "style",
        "template",
        "html",
        "scss",
        "css",
        "layout",
        "prime",
        "tailwind"
      ],
      "stacks": ["frontend"]
    },
    {
      "keywords": [
        "ngrx",
        "signalstore",
        "signal",
        "selector",
        "effect",
        "state",
        "store"
      ],
      "stacks": ["frontend"]
    },
    {
      "keywords": [
        "test",
        "coverage",
        "spec",
        "e2e",
        "unit",
        "integration",
        "mock",
        "stryker",
        "lighthouse",
        "testcontainers",
        "k6"
      ],
      "stacks": ["testing"]
    },
    {
      "keywords": [
        "ci",
        "cd",
        "deploy",
        "docker",
        "workflow",
        "action",
        "pipeline",
        "container",
        "pgbouncer",
        "compose"
      ],
      "stacks": ["ci_cd"]
    }
  ]
}

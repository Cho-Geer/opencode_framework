            },
            "formatVersion": {
              "type": "string",
              "const": "3.0"
            }
          }
        },
        "gate_state_history": {
          "type": "object",
          "description": "Metadata for gate-state.history/ directory",
          "properties": {
            "path": {
              "type": "string",
              "const": ".opencode/state/gate-state.history/"
            },
            "type": {
              "type": "string",
              "const": "jsonl_directory"
            }
          }
        },
        "dag_format": {
          "type": "string",
          "enum": ["1.0", "2.0"],
          "description": "Active Task.DAG.json format version. '2.0' indicates hierarchical storage with external changelog."

        "dag_index": {
          "type": "object",
          "description": "Metadata for Task.DAG.index.json",
          "properties": {
            "path": {
              "type": "string",
              "const": "Task.DAG.index.json"
            },
            "formatVersion": {
              "type": "string",
              "const": "2.0"
            }
          }
        },
        "dag_versions": {
          "type": "object",
          "description": "Metadata for Task.DAG.versions/ directory",
          "properties": {

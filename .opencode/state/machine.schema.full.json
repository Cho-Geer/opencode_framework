    "plugin_state": {
      "type": "object",
      "description": "Framework plugin load state tracking. Synchronized with .task_temp/_logs/index.json by state-reconciliation.",
      "required": ["last_reconciliation", "plugins"],
      "properties": {
        "last_reconciliation": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last reconciliation between machine.json and index.json."
        },
        "plugins": {
          "type": "object",
          "description": "Per-plugin state tracking keyed by plugin name (e.g., session, scope-before, uc7ks-before).",
          "additionalProperties": {
            "type": "object",
            "required": ["loaded", "hooks_registered", "last_seen"],
            "properties": {
              "loaded": {
                "type": "boolean",
                "description": "Whether the plugin module was successfully imported."
              },
              "hooks_registered": {
                "type": "boolean",
                "description": "Whether the plugin registered at least one hook event."
              },
              "last_seen": {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 timestamp of last plugin activity (load or hook trigger)."
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "auto_plan_history": {
      "type": "array",
      "description": "FW-PLAN-FIRST (2026-06-14): Audit trail of autonomous @Meta-Planner dispatches triggered by dispatch_subagent auto_plan. Each record captures caller session, target agent, dag_task_id, planning_dispatch_id, status, and elapsed_ms. Capped at 200 entries by dag-policy.ts.",
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "caller_session",
          "caller_agent",
          "target_agent",
          "dag_task_id",
          "planning_dispatch_id",
          "status"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "caller_session": {
            "type": "string"
          },
          "caller_agent": {
            "type": "string"
          },
          "target_agent": {
            "type": "string"
          },
          "dag_task_id": {
            "type": "string"
          },
          "planning_dispatch_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["attempt", "success", "timeout", "rate_limited", "failure"]
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "type": "string"
          }
        }
      }
    },
    "dispatch_history": {
      "type": "array",
      "description": "FW-PLAN-FIRST (2026-06-14): Audit trail of dispatch_subagent invocations that passed the PLAN-FIRST pre-flight. Each record captures caller agent, target agent, dag_task_id, dag_entry_source (tasks or execution_order), and whether auto_plan was used.",
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "caller_agent",
          "target_agent",
          "dag_task_id"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "caller_agent": {
            "type": "string"
          },
          "target_agent": {
            "type": "string"
          },
          "dag_task_id": {
            "type": "string"
          },
          "dag_entry_source": {
            "type": "string",
            "enum": ["tasks", "execution_order"]
          },
          "dag_entry_status": {

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode.dev/schemas/project.config.schema.json",
  "title": "Opencode Project Configuration",
  "description": "Validates .opencode/project.config.json at startup",
  "type": "object",
  "required": ["project", "project_root", "paths", "tech_stack", "agent_write_scopes"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "project_root": { "type": "string", "description": "Path relative to OPENCODE_ROOT", "default": "." },
    "paths": {
      "type": "object",
      "required": ["backend_src", "frontend_src"],
      "properties": {
        "backend_src": { "type": "string" },
        "frontend_src": { "type": "string" },
        "contracts": { "type": "string", "default": "contract.yaml" },
        "requirements": { "type": "string" },
        "code_standards": { "type": "string" },
        "tests": { "type": "string" },
        "state": { "type": "string", "default": ".opencode/state/" }
      }
    },
    "tech_stack": {
      "type": "object",
      "required": ["backend", "frontend", "database"],
      "properties": {
        "backend": { "type": "object" },
        "frontend": { "type": "object" },
        "database": { "type": "object" },
        "cache": { "type": "object" },
        "auth": { "type": "object" },
        "testing": { "type": "object" },
        "ci_cd": { "type": "string" },
        "container": { "type": "string" }
      }
    },
    "context7_task_mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent", "keywords", "stacks"],
        "properties": {
          "agent": { "type": "string" },
          "keywords": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "stacks": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "priority": { "type": "integer", "minimum": 1, "maximum": 3 }
        }
      }
    },
    "agent_write_scopes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["allowed", "denied"],
        "properties": {
          "allowed": { "type": "array", "items": { "type": "string" } },
          "denied": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}

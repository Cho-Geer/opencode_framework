{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode.dev/state/schemas/eslint-state.schema.json",
  "title": "ESLint State",
  "description": "ESLint mock-audit state tracking per-module and aggregate.",
  "type": "object",
  "required": [
    "modules",
    "aggregate"
  ],
  "properties": {
    "last_full_scan": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "ISO 8601 timestamp of last full scan, or null."
    },
    "modules": {
      "type": "object",
      "description": "Per-module audit state keyed by module name (e.g. all_modules, admin, unknown).",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "violations",
          "last_check",
          "waivers_applied"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "clean",
              "dirty",
              "waived"
            ],
            "description": "Current audit status for this module."
          },
          "violations": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "List of ESLint violation objects."
          },
          "last_check": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of last check."
          },
          "waivers_applied": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Waiver IDs applied to this module."
          }
        },
        "additionalProperties": true
      }
    },
    "aggregate": {
      "type": "object",
      "description": "Aggregate ESLint state across all modules.",
      "required": [
        "total_violations",
        "dirty_modules",
        "waived_modules"
      ],
      "properties": {
        "total_violations": {
          "type": "integer",
          "minimum": 0,
          "description": "Total violation count across all modules."
        },
        "dirty_modules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of module names currently in dirty status."
        },
        "waived_modules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of module names with active waivers."
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode.dev/state/schemas/knowledge-audit-state.schema.json",
  "title": "Knowledge Audit State",
  "description": "UC7KS Knowledge Pipeline audit state. Tracks knowledge acquisition activity across all agents.",
  "type": "object",
  "required": [
    "enabled"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Whether knowledge pipeline auditing is enabled."
    },
    "last_cache_check": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO 8601 timestamp of last cache check."
    },
    "last_knowledge_acquisition": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO 8601 timestamp of last external knowledge acquisition."
    },
    "current_session": {
      "type": "object",
      "description": "Per-session knowledge audit state.",
      "properties": {
        "agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "cache_checked": {
          "type": "boolean"
        },
        "cache_hits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cache_misses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "knowledge_curator_dispatched": {
          "type": "boolean"
        },
        "dispatch_token_validated": {
          "type": "boolean"
        },
        "files_acquired": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "aggregate": {
      "type": "object",
      "description": "Aggregated knowledge pipeline statistics.",
      "properties": {
        "total_cache_checks": {
          "type": "integer"
        },
        "total_cache_hits": {
          "type": "integer"
        },
        "total_cache_misses": {
          "type": "integer"
        },
        "total_curator_dispatches": {
          "type": "integer"
        },
        "total_external_fetches": {
          "type": "integer"
        },
        "cat_know_violations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode.dev/state/schemas/format-state.schema.json",
  "title": "Format State",
  "description": "Prettier format check state.",
  "type": "object",
  "required": [
    "status",
    "unformatted_files",
    "last_check"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "clean",
        "dirty"
      ],
      "description": "Current formatting status."
    },
    "unformatted_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Files not conforming to Prettier."
    },
    "last_check": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "ISO 8601 timestamp of last format check, or null."
    },
    "last_run": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "ISO 8601 timestamp of last format run, or null."
    },
    "auto_fix_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of files auto-fixed by prettier --write."
    }
  },
  "additionalProperties": true
}

                "to": "Testing",
                "requiredEvidence": []
            },
            {
                "from": "Testing",
                "to": "Review",
                "requiredEvidence": [
                    {
                        "filePattern": "tasks/{taskId}/test_report.json",
                        "description": "\u6d4b\u8bd5\u6267\u884c\u62a5\u544a",
                        "schema": {
                            "$schema": "http://json-schema.org/draft-07/schema#",
                            "type": "object",
                            "required": [
                                "execution_evidence",
                                "coverage"
                            ],
                            "properties": {
                                "execution_evidence": {
                                    "type": "object",
                                    "required": [
                                        "exit_code",
                                        "output_summary"
                                    ],
                                    "properties": {
                                        "exit_code": {
                                            "type": "integer",
                                            "description": "\u6d4b\u8bd5\u8fdb\u7a0b\u9000\u51fa\u7801\uff0c0 \u8868\u793a\u5168\u90e8\u901a\u8fc7"
                                        },
                                        "output_summary": {
                                            "type": "string",
                                            "description": "\u6d4b\u8bd5\u6267\u884c\u8f93\u51fa\u6458\u8981"
                                        }
                                    }
                                },
                                "coverage": {
                                    "type": "object",
                                    "properties": {
                                        "lines": {
                                            "type": "number",
                                            "minimum": 70,
                                            "description": "\u884c\u8986\u76d6\u7387\uff08%\uff09\uff0c\u6700\u4f4e 70%"
                                        },
                                        "branches": {
                                            "type": "number",
                                            "description": "\u5206\u652f\u8986\u76d6\u7387\uff08%\uff09"
                                        },
                                        "functions": {
                                            "type": "number",
                                            "description": "\u51fd\u6570\u8986\u76d6\u7387\uff08%\uff09"
                                        },
                                        "statements": {
                                            "type": "number",
                                            "description": "\u8bed\u53e5\u8986\u76d6\u7387\uff08%\uff09"
                                        }
                                    }
                                }
                            },
                            "additionalProperties": true
                        },
                        "contentMustNotContain": "\"failed\": [1-9]"
                    }
                ]
            },
            {
                "from": "Review",
                "to": "Done",
                "requiredEvidence": [
                    {
                        "filePattern": "tasks/{taskId}/guardian_report.md",
                        "description": "@Guardian \u5ba1\u67e5\u62a5\u544a",
                        "contentMustContain": "PASS",
                        "contentMustNotContain": "FAIL"
                    }
                ]
            },
            {
                "from": "Testing",
                "to": "InProgress",
                "requiredEvidence": [
                    {
                        "filePattern": "tasks/{taskId}/test_report.json",
                        "description": "\u6d4b\u8bd5\u6267\u884c\u62a5\u544a\uff08\u5931\u8d25\u65f6\u56de\u9000\uff09",
                        "contentMustContain": "\"exit_code\": 1"
                    }
                ]
            },
            {
                "from": "Review",
                "to": "InProgress",
                "requiredEvidence": [
                    {
                        "filePattern": "tasks/{taskId}/guardian_report.md",
                        "description": "@Guardian \u5ba1\u67e5\u62a5\u544a\uff08\u672a\u901a\u8fc7\u65f6\u56de\u9000\uff09",
                        "contentMustContain": "FAIL"
                    }
                ]
            },
            {
                "from": "InProgress",
                "to": "completed",
                "requiredEvidence": [
                    {
                        "filePattern": "booking_system_refactor/booking-backend/tasks/{taskId}/refactor_report.json",
                        "description": "\u6d4b\u8bd5\u6267\u884c\u62a5\u544a\uff08\u542b execution_evidence\uff09",
                        "contentMustNotContain": "\"failed\": [1-9]"
                    }
                ]
            },
            {
                "from": "in_progress",
                "to": "completed",
                "requiredEvidence": [
                    {
                        "filePattern": "booking_system_refactor/booking-backend/tasks/{taskId}/refactor_report.json",

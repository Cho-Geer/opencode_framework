#!/bin/bash
# Root repo pre-commit hook — v3.1.0
# Multi-layer enforcement:
#   0.   Compliance Gate Armed Check (PHYSICAL ENFORCEMENT)
#   1.5  Rule Registry Verification (live digest comparison)
#   1.   lint-staged (formatting + eslint fix)
#   2.   keystone-validate (contract hash + evidence + type check + deps + full audit)
#   3.   commit-msg (delegated to commit-msg hook)
set -e

ROOT="$(git rev-parse --show-toplevel)"
INNER="$ROOT/$(/home/zhaoge/.bun/bin/bun -e "console.log(require('./.opencode/project.config.json').project_root)")"

# ── Fallback path resolution: when $INNER paths don't exist, try $ROOT/.opencode/ ──
# Handles monorepo edge cases where project_root nesting differs from .opencode layout
VALIDATOR="$INNER/scripts/keystone-validate.ts"
MACHINE="$INNER/.opencode/state/machine.json"
GATE_STATE="$INNER/.opencode/state/gate-state.json"
ENF_SCRIPT="$INNER/.opencode/scripts/enforcement-mode-check.sh"

# If INNER-prefixed paths don't resolve, fall back to ROOT/.opencode/
if [ ! -f "$VALIDATOR" ]; then
  VALIDATOR="$ROOT/.opencode/scripts/mcp-tools/keystone-validate.ts"
fi
if [ ! -f "$MACHINE" ]; then
  MACHINE="$ROOT/.opencode/state/machine.json"
fi
if [ ! -f "$GATE_STATE" ]; then
  GATE_STATE="$ROOT/.opencode/state/gate-state.json"
fi
if [ ! -f "$ENF_SCRIPT" ] && [ -f "$ROOT/.opencode/scripts/enforcement-mode-check.sh" ]; then
  ENF_SCRIPT="$ROOT/.opencode/scripts/enforcement-mode-check.sh"
fi

# ── Resolve Enforcement Mode ──────────────────────────────────────────
ENF_MODE="advisory"
if [ -x "$ENF_SCRIPT" ]; then
  ENF_MODE=$("$ENF_SCRIPT" 2>/dev/null || echo "advisory")
elif [ -f "$INNER/.opencode/project.config.json" ]; then
  ENF_MODE=$(/home/zhaoge/.bun/bin/bun -e "
    try {
      const cfg = require('$INNER/.opencode/project.config.json');
      // FW-REPAIR-12: Resolve dual-key enforcement mode per enforcement-modes-standard.md §4.1
      // Pre-commit is CI-bound → runtime_enforcement_mode takes priority
      // develop_enforcement_mode is for in-agent code only
      const mode = cfg.template_resolution?.runtime_enforcement_mode
                || cfg.template_resolution?.develop_enforcement_mode;
      console.log(mode && ['advisory','strict','locked'].includes(mode) ? mode : 'advisory');
    } catch(e) { console.log('advisory'); }
  " 2>/dev/null || echo "advisory")
fi

if [ -n "${ENFORCEMENT_MODE:-}" ]; then
  case "${ENFORCEMENT_MODE}" in
    advisory|strict|locked)
      if [ "$ENF_MODE" != "locked" ]; then
        ENF_MODE="${ENFORCEMENT_MODE}"
      fi
      ;;
  esac
fi

echo "═══════════════════════════════════════════════════════════════"
echo "  🔍 OpenCode v3.2 Pre-Commit Hook — Multi-Layer Enforcement"
echo "  Mode: $ENF_MODE"
echo "═══════════════════════════════════════════════════════════════"

# ── Layer 0: Compliance Gate Armed Check (mode-aware) ──
echo ""
echo "[Layer 0/4] Checking compliance gate state..."
if [ "$ENF_MODE" = "advisory" ]; then
    echo "  ⚠️  [ADVISORY] Gate armed check skipped (advisory mode)"
elif [ -f "$GATE_STATE" ]; then
    # FW-REPAIR-12: Handle both V2 (array) and V3 (object) active_sessions format
    ARMED=$(/home/zhaoge/.bun/bin/bun -e "
      const g=require('$GATE_STATE');
      const sessions = g.active_sessions;
      if (!sessions) { console.log(0); process.exit(0); }
      // V3 format: { session_id: { ... } } (object) — use key count
      // V2 format: [session_id, ...] (array) — use length
      console.log(Array.isArray(sessions) ? sessions.length : Object.keys(sessions).length);
    " 2>/dev/null || echo "0")
    if [ "$ARMED" = "0" ]; then
        echo "❌ [GATE] No compliance gate session is armed for this commit."
        echo "   Run: compliance_gate_check → compliance_gate_confirm before committing."
        echo "   All tasks MUST go through the compliance gate lifecycle."
        exit 1
    fi
    echo "  ✅ Compliance gate armed ($ARMED active session(s))"
else
    echo "  ⚠️  gate-state.json not found — compliance gate check skipped"
fi

# ── Layer 1.5: Rule Registry Verification ──
echo ""
echo "[1.5/4] Rule registry verification..."
registry_output=$(bun .opencode/scripts/rule-registry-verify.ts --strict --json 2>&1) || true
has_high=$(echo "$registry_output" | python3 -c "import sys,json; d=json.load(sys.stdin); print('yes' if any(v['severity']=='HIGH' for v in d.get('violations',[])) else 'no')" 2>/dev/null || echo "unknown")
if [ "$has_high" = "yes" ]; then
  echo "  ❌ HIGH registry violations found — commit blocked"
  echo "$registry_output" | python3 -c "import sys,json; d=json.load(sys.stdin); [print(f'    - {v[\"detail\"]}') for v in d.get('violations',[]) if v['severity']=='HIGH']" 2>/dev/null
  echo "  🔧 Fix: bun .opencode/scripts/rule-registry-verify.ts --repair"
  exit 1
else
  if [ "$has_high" = "unknown" ]; then
    echo "  ⚠️  Could not parse registry verification result (non-blocking)"
  else
    echo "  ✅ Rule registry verification passed"
  fi
fi

# ── Layer 1.8 — Gate lifecycle audit ──
echo ""
echo "[1.8/4] Gate lifecycle audit..."
audit_output=$(bun .opencode/scripts/gate-lifecycle-audit.ts --json 2>&1) || true
stale_count=$(echo "$audit_output" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len([s for s in d.get('stale_sessions',[]) if s.get('hours_old',0)>24]))" 2>/dev/null || echo "0")
if [ "$stale_count" -gt 0 ] 2>/dev/null; then
  echo "  ⚠️  $stale_count stale gate session(s) found (>24h)"
  echo "  🔧 Fix: Run bun .opencode/scripts/state-reconciliation.ts --fix"
else
  echo "  ✅ No stale gate sessions"
fi

# ── Layer 1.9: State Format Validation (v3 gate-state + v2 DAG cross-file integrity) ──
echo ""
echo "[1.9/4] State format validation (v3 gate-state + v2 DAG)..."
GATE_INDEX="$ROOT/.opencode/state/gate-state.index.json"
GATE_ARCHIVE="$ROOT/.opencode/state/gate-state.archive.json"
DAG_CHANGELOG="$ROOT/Task.DAG.changelog.md"

# ── gate-state v3 schema validation (FW-REPAIR-12) ──
GATE_V3_SCHEMA="$ROOT/.opencode/state/gate-state.v3.schema.json"
if [ -f "$GATE_V3_SCHEMA" ]; then
  SCHEMA_VALID=$(bun -e "
    try {
      const Ajv = require('ajv');
      const schema = require('$GATE_V3_SCHEMA');
      const hot = require('$GATE_STATE');
      const ajv = new Ajv({ allErrors: true });
      const valid = ajv.validate(schema, hot);
      if (!valid) {
        console.log('FAIL:' + ajv.errorsText(ajv.errors));
        process.exit(0);
      }
      console.log('OK');
    } catch(e) { console.log('ERR:' + e.message); process.exit(0); }
  " 2>/dev/null || echo "CHECK_FAILED")
  
  if [ "$SCHEMA_VALID" = "OK" ]; then
    echo "  ✅ gate-state.json V3 schema valid"
  elif echo "$SCHEMA_VALID" | grep -q "^FAIL:"; then
    echo "  ⚠️  V3 schema: $SCHEMA_VALID"
    if [ "$ENF_MODE" != "advisory" ]; then
      echo "  ❌ gate-state.json fails V3 schema — commit BLOCKED in $ENF_MODE mode"
      exit 1
    fi
  else
    echo "  ⚠️  V3 schema check skipped ($SCHEMA_VALID)"
  fi
fi

# ── gate-state v3 cross-file integrity ──
if [ -f "$GATE_STATE" ]; then
  FORMAT_VERSION=$(bun -e "try{console.log(require('$GATE_STATE').formatVersion||'1.0')}catch(e){console.log('1.0')}" 2>/dev/null)

  if [ "$FORMAT_VERSION" = "3.0" ]; then
    HOT_ACTIVE=$(bun -e "try{console.log(Object.keys(require('$GATE_STATE').active_sessions||{}).length)}catch(e){console.log(0)}" 2>/dev/null)
    HOT_RECENT=$(bun -e "try{console.log(Object.keys(require('$GATE_STATE').recent_sessions||{}).length)}catch(e){console.log(0)}" 2>/dev/null)

    if [ -f "$GATE_INDEX" ]; then
      INDEX_COUNT=$(bun -e "try{console.log(Object.keys(require('$GATE_INDEX').sessions||{}).length)}catch(e){console.log(0)}" 2>/dev/null)
      if [ "$INDEX_COUNT" -lt "$HOT_RECENT" ] 2>/dev/null; then
        echo "  ❌ gate-state v3 inconsistency: index ($INDEX_COUNT) < recent ($HOT_RECENT)"
        exit 1
      fi
    fi

    if [ -f "$GATE_ARCHIVE" ]; then
      ARCHIVE_COUNT=$(bun -e "try{console.log(require('$GATE_ARCHIVE').session_count||0)}catch(e){console.log(0)}" 2>/dev/null)
      echo "  ✅ gate-state v3: active=$HOT_ACTIVE recent=$HOT_RECENT index=$INDEX_COUNT archive=$ARCHIVE_COUNT"
    else
      echo "  ✅ gate-state v3: active=$HOT_ACTIVE recent=$HOT_RECENT index=$INDEX_COUNT"
    fi
  else
    echo "  ⚠️  gate-state v2 format (pre-migration) — consider running migration script"
  fi

  # ── archive_ref spot-check (v3 cross-file integrity) ──
  if [ "$FORMAT_VERSION" = "3.0" ] && [ -n "$HOT_RECENT" ] && [ "$HOT_RECENT" -gt 0 ] 2>/dev/null; then
    SPOT_COUNT=0
    ARCHIVE_REFS=$(bun -e "try{const s=require('$GATE_STATE').recent_sessions||{};Object.values(s).slice(0,3).forEach(v=>{if(v.archive_ref)console.log(v.archive_ref)})}catch(e){}" 2>/dev/null)
    for ref in $ARCHIVE_REFS; do
      [ -z "$ref" ] && continue
      HISTORY_FILE=$(echo "$ref" | cut -d'#' -f1)
      if [ ! -f "$ROOT/.opencode/state/$HISTORY_FILE" ]; then
        echo "  ❌ gate-state v3: archive_ref points to missing file: $HISTORY_FILE"
        exit 1
      fi
      SPOT_COUNT=$((SPOT_COUNT + 1))
    done
    if [ "$SPOT_COUNT" -gt 0 ] 2>/dev/null; then
      echo "  ✅ archive_ref spot-check: $SPOT_COUNT refs validated"
    fi
  fi
fi

# ── Task.DAG v2: changelog should be in .md, not in hot file ──
DAG_FILE="$ROOT/Task.DAG.json"
if [ -f "$DAG_FILE" ]; then
  HAS_CHANGELOG=$(bun -e "try{const d=require('$DAG_FILE'); console.log(d.change_log?'yes':'no')}catch(e){console.log('unknown')}" 2>/dev/null)
  if [ "$HAS_CHANGELOG" = "yes" ]; then
    echo "  ⚠️  Task.DAG.json still has inline change_log — consider running DAG migration"
  elif [ -f "$DAG_CHANGELOG" ]; then
    echo "  ✅ Task.DAG.json: changelog externalized to changelog.md"
  fi
fi

# ── Layer 1: lint-staged (auto-format + eslint fix) ──
if [ -f "$INNER/node_modules/.bin/lint-staged" ]; then
    echo ""
    echo "[Layer 1/4] Auto-formatting staged files (lint-staged)..."
    npx --prefix "$INNER" lint-staged --concurrent false || {
        echo "⚠️  [lint-staged] Some files could not be auto-fixed."
    }
else
    echo "[Layer 1/4] lint-staged not installed — skipping auto-format"
fi

# ── Layer 2.5: TDD Order Pre-Check (mode-aware) ──
TDD_IMPL_FILES=$(git diff --cached --name-only | grep -E '\.(ts|js)$' | grep -v '\.spec\.\|\.test\.\|/test/\|\.config\.' || true)
TDD_TEST_FILES=$(git diff --cached --name-only | grep -E '\.spec\.|\.test\.|/test/' || true)
if [ -n "$TDD_IMPL_FILES" ] && [ -z "$TDD_TEST_FILES" ]; then
    COMMIT_MSG=$(git log -1 --format=%s 2>/dev/null || echo "")
    if ! echo "$COMMIT_MSG" | grep -qiE '\[(Red|Green|Refactor)\]'; then
        if [ "$ENF_MODE" = "advisory" ]; then
            echo "⚠️  [ADVISORY] Implementation files staged without test files AND no TDD tag (non-blocking in advisory mode)."
            echo "  Impl files: $TDD_IMPL_FILES"
        else
            echo "❌ [TDD] Implementation files staged without test files AND no TDD tag in commit message."
            echo "  Impl files: $TDD_IMPL_FILES"
            echo "  This is a TDD violation. Commit BLOCKED."
            echo "  Fix: Add corresponding test files, or include [Red]/[Green]/[Refactor] in commit message."
            exit 1
        fi
    fi
fi

# ── Layer 2.6: UC7KS Docs Consistency Check (mode-aware) ──
echo ""
echo "[Layer 2.6/4] Checking UC7KS docs consistency..."
INDEX_FILE="$ROOT/docs/official_docs/index.json"
DOCS_DIR="$ROOT/docs/official_docs/"
if [ -f "$INDEX_FILE" ]; then
  # Verify index.json is valid JSON and has required fields
  INDEX_VALID=$(bun -e "
    try {
      const idx = require('$INDEX_FILE');
      if (!idx.manifest_version || !idx.entries) { console.log('invalid'); process.exit(0); }
      console.log('valid');
    } catch(e) { console.log('invalid'); }
  " 2>/dev/null || echo "invalid")

  if [ "$INDEX_VALID" != "valid" ]; then
    if [ "$ENF_MODE" = "advisory" ]; then
      echo "  ⚠️  [ADVISORY] docs/official_docs/index.json is malformed — non-blocking in advisory mode"
    else
      echo "  ❌ [UC7KS] docs/official_docs/index.json is malformed — commit BLOCKED"
      echo "     Fix: Run bun .opencode/scripts/framework-self-test.ts to validate"
      exit 1
    fi
  else
    # Check staged docs files are registered in index.json
    STAGED_DOCS=$(git diff --cached --name-only | grep '^docs/official_docs/' | grep -v 'index\.json' | grep -v '\.metadata/' || true)
    if [ -n "$STAGED_DOCS" ]; then
      ORPHAN_DOCS=""
      for doc in $STAGED_DOCS; do
        IN_INDEX=$(bun -e "
          const idx = require('$INDEX_FILE');
          const found = idx.entries.some(e => e.files.some(f => '$doc'.includes(f.path)));
          console.log(found ? 'yes' : 'no');
        " 2>/dev/null || echo "no")
        if [ "$IN_INDEX" = "no" ]; then
          ORPHAN_DOCS="$ORPHAN_DOCS $doc"
        fi
      done
      if [ -n "$ORPHAN_DOCS" ]; then
        if [ "$ENF_MODE" = "advisory" ]; then
          echo "  ⚠️  [ADVISORY] Staged docs not registered in index.json:$ORPHAN_DOCS"
        else
          echo "  ❌ [UC7KS] Staged docs not registered in index.json:$ORPHAN_DOCS"
          exit 1
        fi
      else
        echo "  ✅ Staged docs verified in index.json"
      fi
    fi
    echo "  ✅ index.json manifest integrity verified"
  fi
else
  echo "  ⚠️  docs/official_docs/index.json not found — skipping UC7KS check"
fi

# ── Layer 2: keystone-validate (mode-aware) ──
echo ""
echo "[Layer 2/4] Running keystone full validation..."

if [ ! -f "$VALIDATOR" ]; then
    echo "⚠️  [Keystone] keystone-validate.js not found at $VALIDATOR — skipping validation"
else
    if [ ! -f "$MACHINE" ]; then
        echo "⚠️  [Keystone] machine.json not found at $MACHINE — no Keystone constraints active"
    else
        if /home/zhaoge/.bun/bin/bun "$VALIDATOR" --pre-commit; then
            echo "  ✅ Keystone validation passed."
        else
            if [ "$ENF_MODE" = "advisory" ]; then
                echo "  ⚠️  [ADVISORY] Keystone validation failed (non-blocking in advisory mode)."
            else
                echo ""
                echo "═══════════════════════════════════════════════════════════════"
                echo "  ❌ PRE-COMMIT REJECTED — Keystone validation failed"
                echo "═══════════════════════════════════════════════════════════════"
                echo ""
                echo "Fix the violations above and re-stage the files:"
                echo "  git add <fixed-files> && git commit"
                exit 1
            fi
        fi
    fi
fi

echo ""
echo "[Layer 3/4] Commit message validation delegated to commit-msg hook"
echo ""
echo "═══════════════════════════════════════════════════════════════"
echo "  ✅ PRE-COMMIT PASSED — All checks clear"
echo "═══════════════════════════════════════════════════════════════"

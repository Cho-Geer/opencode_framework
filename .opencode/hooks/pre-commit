#!/bin/bash
# .opencode/hooks/pre-commit
# Qoder 物理约束钩子 v4.0
# 阶段0: machine.json Schema 自校验
# 阶段1: 契约哈希强制校验 + 业务代码提交必须伴随 Task.DAG.json 变更
# 阶段2: 任务生命周期强制证据校验 (使用 ajv 进行 Schema 校验)
# 阶段3: TDD 分步提交校验（文件类型/commit 标记/时序强制）

set -e

MACHINE_FILE=".opencode/state/machine.json"
MACHINE_SCHEMA=".opencode/state/machine.schema.json"
OPENCODE_ROOT="$(git rev-parse --show-toplevel)"

# 契约文件配置：从 machine.json contracts 动态读取（git-root-relative 路径）
declare -A CONTRACT_FILES=()

load_contract_files() {
    local machine_path="$OPENCODE_ROOT/$MACHINE_FILE"

    if [ ! -f "$machine_path" ]; then
        return
    fi

    local keys
    keys=$(jq -r '.contracts | keys[]' "$machine_path" 2>/dev/null)
    for key in $keys; do
        local file
        file=$(jq -r ".contracts[\"$key\"].file" "$machine_path" 2>/dev/null)
        if [ -n "$file" ] && [ "$file" != "null" ]; then
            CONTRACT_FILES["$key"]="$file"
        fi
    done
}

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# 项目配置文件路径
PROJECT_CONFIG=".opencode/project.config.json"

# 从 project.config.json 读取 project_root (默认为 ".", 即 OPENCODE_ROOT 自身)
read_project_root() {
    local config_path="$OPENCODE_ROOT/$PROJECT_CONFIG"
    if [ -f "$config_path" ]; then
        local root
        root=$(jq -r '.project_root // "."' "$config_path" 2>/dev/null)
        if [ -n "$root" ] && [ "$root" != "null" ]; then
            echo "$root"
            return
        fi
    fi
    echo "."
}

# 从 project.config.json 读取配置项，自动拼接 project_root 前缀
read_config() {
    local key="$1"
    local default="$2"
    local config_path="$OPENCODE_ROOT/$PROJECT_CONFIG"
    if [ -f "$config_path" ]; then
        local value
        value=$(jq -r "$key" "$config_path" 2>/dev/null)
        if [ -n "$value" ] && [ "$value" != "null" ]; then
            echo "$value"
            return
        fi
    fi
    echo "$default"
    if [ -f "$config_path" ]; then
        local value
        value=$(jq -r "$key" "$config_path" 2>/dev/null)
        if [ -n "$value" ] && [ "$value" != "null" ]; then
            echo "$value"
            return
        fi
    fi
    echo "$default"
}

# 检查依赖
check_dependencies() {
    if ! command -v jq &> /dev/null; then
        echo -e "${RED}❌ [Qoder] jq 未安装，请执行: brew install jq 或 apt install jq${NC}"
        exit 1
    fi
    
    if ! command -v node &> /dev/null; then
        echo -e "${RED}❌ [Qoder] Node.js 未安装${NC}"
        exit 1
    fi
}

# 使用 ajv + ajv-formats 验证 JSON Schema (draft-07)
validate_with_ajv() {
    local file="$1"
    local schema="$2"
    
    # 查找 ajv 所在的 node_modules 目录（支持多候选路径）
    local NM_HINT=$(read_config '.paths.node_modules_hint' "")
    local NODE_PATH_CANDIDATES=()
    if [ -n "$NM_HINT" ]; then
        NODE_PATH_CANDIDATES+=("$OPENCODE_ROOT/$NM_HINT")
    fi
    NODE_PATH_CANDIDATES+=("$OPENCODE_ROOT/node_modules")
    local AJV_NODE_PATH=""
    for candidate in "${NODE_PATH_CANDIDATES[@]}"; do
        if [ -d "$candidate/ajv" ]; then
            AJV_NODE_PATH="$candidate"
            break
        fi
    done

    if [ -z "$AJV_NODE_PATH" ]; then
        echo -e "${RED}❌ [Qoder] ajv 未安装，JSON Schema 校验不可跳过${NC}"
        echo "   安装方式："
        local nm_dir=$(basename "${NM_HINT:-node_modules}")
        local proj_dir="${NM_HINT%/$nm_dir}" 2>/dev/null || echo "."
        echo "   cd ${proj_dir:-.} && npm install --save-dev ajv ajv-formats"
        exit 1
    fi

    NODE_PATH="$AJV_NODE_PATH" node -e "
        const fs = require('fs');
        const Ajv = require('ajv');
        const addFormats = require('ajv-formats');
        const ajv = new Ajv({ allErrors: true, strict: false });
        addFormats(ajv);
        const schema = JSON.parse(fs.readFileSync('${schema}', 'utf8'));
        const data = JSON.parse(fs.readFileSync('${file}', 'utf8'));
        const validate = ajv.compile(schema);
        const valid = validate(data);
        if (!valid) {
            console.error(JSON.stringify(validate.errors, null, 2));
            process.exit(1);
        }
        process.exit(0);
    " 2>&1
}

# 计算文件或目录的 SHA256 哈希
calculate_hash() {
    local path="$1"
    local full_path="$OPENCODE_ROOT/$path"

    if [ ! -e "$full_path" ]; then
        echo ""
        return
    fi

    if [ -d "$full_path" ]; then
        # 与 update-machine-hash.js 保持一致：
        # 仅读取直接子文件（非递归）中的 .ts 文件，按文件名排序，
        # 内容用 \n---FILE_SEPARATOR---\n 连接后计算哈希
        local files=$(ls "$full_path"/*.ts 2>/dev/null | sort)
        if [ -z "$files" ]; then
            echo "sha256-e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        else
            # 用 node 复刻 JS 逻辑，确保分隔符一致
            local NM_HINT=$(read_config '.paths.node_modules_hint' "")
            local NODE_PATH_CANDIDATES=()
            if [ -n "$NM_HINT" ]; then
                NODE_PATH_CANDIDATES+=("$OPENCODE_ROOT/$NM_HINT")
            fi
            NODE_PATH_CANDIDATES+=("$OPENCODE_ROOT/node_modules")
            local HASH_NODE_PATH=""
            for candidate in "${NODE_PATH_CANDIDATES[@]}"; do
                if [ -d "$candidate" ]; then
                    HASH_NODE_PATH="$candidate"
                    break
                fi
            done
            node -e "
                const fs = require('fs');
                const crypto = require('crypto');
                const dir = '${full_path}';
                const files = fs.readdirSync(dir).filter(f => f.endsWith('.ts')).sort();
                if (files.length === 0) { process.stdout.write('sha256-e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'); process.exit(0); }
                const combined = files.map(f => fs.readFileSync(require('path').join(dir, f), 'utf8')).join('\n---FILE_SEPARATOR---\n');
                const hash = crypto.createHash('sha256').update(combined).digest('hex');
                process.stdout.write('sha256-' + hash);
            " 2>/dev/null
        fi
    else
        sha256sum "$full_path" | awk '{print "sha256-"$1}'
    fi
}

# 从 machine.json 读取期望哈希
get_expected_hash() {
    local key="$1"
    jq -r ".contracts[\"$key\"].hash" "$OPENCODE_ROOT/$MACHINE_FILE" 2>/dev/null
}

# ============================================================================
# 阶段0: machine.json Schema 自校验
# ============================================================================
phase0_schema_self_check() {
    if [ ! -f "$OPENCODE_ROOT/$MACHINE_SCHEMA" ]; then
        echo -e "${YELLOW}⚠️ [Qoder/阶段0] machine.schema.json 未找到，跳过 Schema 自校验${NC}"
        return 0
    fi

    echo -e "${BLUE}🔍 [Qoder/阶段0] 执行 machine.json Schema 自校验...${NC}"
    
    if validate_with_ajv "$OPENCODE_ROOT/$MACHINE_FILE" "$OPENCODE_ROOT/$MACHINE_SCHEMA"; then
        echo -e "${GREEN}✅ [Qoder/阶段0] Schema 自校验通过${NC}"
    else
        echo -e "${RED}❌ [Qoder/阶段0] machine.json 不符合 Schema 定义${NC}"
        echo "   请检查 .opencode/state/machine.json 格式"
        exit 1
    fi
}

# ============================================================================
# 阶段1: 契约哈希强制校验
# ============================================================================
phase1_contract_check() {
    local changed_files=$(git diff --cached --name-only)
    local contract_changed=false
    local contracts_changed=""

    for key in "${!CONTRACT_FILES[@]}"; do
        local file="${CONTRACT_FILES[$key]}"
        if echo "$changed_files" | grep -qE "^${file}"; then
            contract_changed=true
            contracts_changed="$contracts_changed\n  - $key ($file)"
        fi
    done

    if [ "$contract_changed" = false ]; then
        return 0
    fi

    echo -e "${BLUE}🔍 [Qoder/阶段1] 检测到契约文件变更，正在执行严格校验...${NC}"
    echo -e "${YELLOW}   变更的契约：$contracts_changed${NC}\n"

    if ! echo "$changed_files" | grep -q "^$MACHINE_FILE"; then
        echo -e "${RED}❌ [Qoder] 拒绝提交：契约文件已变更，但未同步更新 $MACHINE_FILE${NC}"
        echo ""
        echo -e "${YELLOW}   解决方案：${NC}"
        echo "   1. 运行自动更新脚本："
        echo "      npm run qoder:hash"
        echo "   2. 将变更后的 $MACHINE_FILE 加入暂存区："
        echo "      git add $MACHINE_FILE"
        echo "   3. 重新提交"
        exit 1
    fi

    echo -e "${BLUE}   正在校验哈希值匹配...${NC}"
    local all_match=true
    local mismatch_details=""

    for key in "${!CONTRACT_FILES[@]}"; do
        local file="${CONTRACT_FILES[$key]}"
        if ! echo "$changed_files" | grep -qE "^${file}"; then
            continue
        fi

        local actual_hash=$(calculate_hash "$file")
        local expected_hash=$(get_expected_hash "$key")

        if [ -z "$actual_hash" ]; then
            echo -e "${YELLOW}   ⚠️  $key: 文件不存在 ($file)${NC}"
            continue
        fi

        if [ "$actual_hash" != "$expected_hash" ]; then
            all_match=false
            mismatch_details="$mismatch_details\n   ${RED}❌ $key:${NC}"
            mismatch_details="$mismatch_details\n      期望: $expected_hash"
            mismatch_details="$mismatch_details\n      实际: $actual_hash"
        else
            echo -e "   ${GREEN}✅ $key: 哈希匹配${NC}"
        fi
    done

    if [ "$all_match" = false ]; then
        echo -e "${RED}❌ [Qoder] 拒绝提交：哈希值不匹配${NC}"
        echo -e "$mismatch_details"
        echo ""
        echo -e "${YELLOW}   解决方案：${NC}"
        echo "   1. 重新计算并更新哈希："
        echo "      npm run qoder:hash"
        echo "   2. 重新暂存并提交"
        exit 1
    fi

    echo -e "${GREEN}✅ [Qoder/阶段1] 契约哈希校验通过${NC}"
}

# ============================================================================
# 阶段2: 任务生命周期强制证据校验 (使用 ajv)
# ============================================================================
phase2_task_lifecycle_check() {
    local changed_files=$(git diff --cached --name-only)
    local task_state_pattern=$(jq -r '.taskLifecycle.taskStateFilePattern // "Task.DAG.json"' "$OPENCODE_ROOT/$MACHINE_FILE")

    if ! echo "$changed_files" | grep -qF "$task_state_pattern"; then
        return 0
    fi

    echo -e "${BLUE}🔍 [Qoder/阶段2] 检测到任务状态文件变更，正在执行生命周期强制校验...${NC}"

    local head_tasks=$(git show "HEAD:$task_state_pattern" 2>/dev/null | jq -c '.tasks // []' || echo "[]")
    local staged_tasks=$(git show ":$task_state_pattern" 2>/dev/null | jq -c '.tasks // []' || echo "[]")

    for staged_task in $(echo "$staged_tasks" | jq -c '.[]'); do
        local task_id=$(echo "$staged_task" | jq -r '.id')
        local new_status=$(echo "$staged_task" | jq -r '.status')
        local old_task=$(echo "$head_tasks" | jq -c ".[] | select(.id == \"$task_id\")")
        
        if [ -z "$old_task" ]; then
            continue
        fi
        
        local old_status=$(echo "$old_task" | jq -r '.status')
        
        if [ "$old_status" = "$new_status" ]; then
            continue
        fi
        
        echo -e "  → 任务 ${task_id}: ${old_status} → ${new_status}"
        
        local transition_rule=$(jq -c --arg from "$old_status" --arg to "$new_status" \
            '.taskLifecycle.transitions[] | select(.from == $from and .to == $to)' \
            "$OPENCODE_ROOT/$MACHINE_FILE")
        
        if [ -z "$transition_rule" ]; then
            echo -e "${RED}❌ [Qoder] 任务 $task_id 的非法状态转换: $old_status → $new_status${NC}"
            echo "   允许的转换路径请查阅 .opencode/state/machine.json 中的 taskLifecycle.transitions"
            exit 1
        fi
        
        local required_evidence=$(echo "$transition_rule" | jq -c '.requiredEvidence[]? // empty')
        if [ -z "$required_evidence" ]; then
            continue
        fi
        
        while IFS= read -r evidence; do
            [ -z "$evidence" ] && continue
            local file_pattern=$(echo "$evidence" | jq -r '.filePattern' | sed "s/{taskId}/$task_id/g")
            local description=$(echo "$evidence" | jq -r '.description // "证据文件"')
            local schema_def=$(echo "$evidence" | jq -c '.schema // empty')
            
            if ! git show ":$file_pattern" >/dev/null 2>&1; then
                echo -e "${RED}❌ [Qoder] 任务 $task_id 缺少证据文件: $file_pattern${NC}"
                echo "   描述: $description"
                exit 1
            fi
            
            local file_content=$(git show ":$file_pattern")
            
            # 使用 ajv 进行 Schema 校验（如果定义了 schema）
            if [ -n "$schema_def" ] && [[ "$file_pattern" == *.json ]]; then
                local temp_schema=$(mktemp)
                local temp_data=$(mktemp)
                echo "$schema_def" > "$temp_schema"
                echo "$file_content" > "$temp_data"
                
                if ! validate_with_ajv "$temp_data" "$temp_schema"; then
                    echo -e "${RED}❌ [Qoder] 证据文件 $file_pattern 不符合 Schema 定义${NC}"
                    rm -f "$temp_schema" "$temp_data"
                    exit 1
                fi
                rm -f "$temp_schema" "$temp_data"
            fi
            
            local must_contain=$(echo "$evidence" | jq -r '.contentMustContain // empty')
            if [ -n "$must_contain" ]; then
                if ! echo "$file_content" | grep -qE "$must_contain"; then
                    echo -e "${RED}❌ [Qoder] 证据文件 $file_pattern 必须匹配模式: $must_contain${NC}"
                    exit 1
                fi
            fi
            
            local must_not_contain=$(echo "$evidence" | jq -r '.contentMustNotContain // empty')
            if [ -n "$must_not_contain" ]; then
                if echo "$file_content" | grep -qE "$must_not_contain"; then
                    echo -e "${RED}❌ [Qoder] 证据文件 $file_pattern 不得包含模式: $must_not_contain${NC}"
                    exit 1
                fi
            fi
        done <<< "$required_evidence"
    done

    echo -e "${GREEN}✅ [Qoder/阶段2] 任务生命周期校验通过${NC}"
}

# ============================================================================
# 阶段1.5: 业务代码提交必须伴随 Task.DAG.json 状态变更
# ============================================================================
phase1_5_task_dag_coupling() {
    local changed_files=$(git diff --cached --name-only)

    # 检测是否包含业务代码文件（排除文档/配置/种子/migration）
    local PROJECT_ROOT=$(read_project_root)
    local BE_SRC=$(read_config '.paths.backend_src' 'booking-backend/src/')
    local FE_SRC=$(read_config '.paths.frontend_src' 'booking-frontend/src/')
    local business_code=false
    while IFS= read -r file; do
        # 后端 src 目录下的 .ts 文件（排除 seed 和 migration）
        if echo "$file" | grep -qE "^${PROJECT_ROOT}/${BE_SRC}.*\.ts$"; then
            if ! echo "$file" | grep -qE '(seed|migration)'; then
                business_code=true
                break
            fi
        fi
        # 前端 src 目录下的 .ts 文件
        if echo "$file" | grep -qE "^${PROJECT_ROOT}/${FE_SRC}.*\.ts$"; then
            business_code=true
            break
        fi
    done <<< "$changed_files"

    if [ "$business_code" = false ]; then
        return 0
    fi

    echo -e "${BLUE}🔍 [Qoder/阶段1.5] 检测到业务代码提交，验证 Task.DAG.json 联动...${NC}"

    local task_state_pattern=$(jq -r '.taskLifecycle.taskStateFilePattern // "Task.DAG.json"' "$OPENCODE_ROOT/$MACHINE_FILE")

    if ! echo "$changed_files" | grep -qF "$task_state_pattern"; then
        echo -e "${RED}❌ [Qoder] 拒绝提交：业务代码已变更，但未同步更新 $task_state_pattern${NC}"
        echo ""
        echo -e "${YELLOW}   原因：${NC}业务代码提交必须伴随任务状态变更，确保 TDD 生命周期可追溯"
        echo ""
        echo -e "${YELLOW}   解决方案：${NC}"
        echo "   1. 在 $task_state_pattern 中更新对应任务的状态（如 InProgress → Red）"
        echo "   2. 将 $task_state_pattern 加入暂存区："
        echo "      git add $task_state_pattern"
        echo "   3. 重新提交"
        echo ""
        echo -e "${YELLOW}   例外（无需更新 Task.DAG.json）：${NC}"
        echo "   - 纯文档修改 (.md)"
        echo "   - 配置文件 (.json/.yaml 非 Task.DAG.json)"
        echo "   - seed.ts / migration 文件"
        exit 1
    fi

    # 验证 Task.DAG.json 中至少有一个任务状态发生了变更
    local head_tasks=$(git show "HEAD:$task_state_pattern" 2>/dev/null | jq -c '.tasks // []' || echo "[]")
    local staged_tasks=$(git show ":$task_state_pattern" 2>/dev/null | jq -c '.tasks // []' || echo "[]")

    local state_changed=false
    for staged_task in $(echo "$staged_tasks" | jq -c '.[]'); do
        local task_id=$(echo "$staged_task" | jq -r '.id')
        local new_status=$(echo "$staged_task" | jq -r '.status')
        local old_task=$(echo "$head_tasks" | jq -c ".[] | select(.id == \"$task_id\")")

        if [ -z "$old_task" ]; then
            # 新增任务，算作状态变更
            state_changed=true
            break
        fi

        local old_status=$(echo "$old_task" | jq -r '.status')
        if [ "$old_status" != "$new_status" ]; then
            state_changed=true
            break
        fi
    done

    if [ "$state_changed" = false ]; then
        echo -e "${RED}❌ [Qoder] 拒绝提交：$task_state_pattern 已变更但无任务状态转换${NC}"
        echo "   至少需要一个任务的状态发生合法变更（如 InProgress → Red）"
        exit 1
    fi

    echo -e "${GREEN}✅ [Qoder/阶段1.5] Task.DAG.json 联动校验通过${NC}"
}

# ============================================================================
# 阶段3: TDD 分步提交校验
# ============================================================================
phase3_tdd_commit_check() {
    local changed_files=$(git diff --cached --name-only)
    local task_state_pattern=$(jq -r '.taskLifecycle.taskStateFilePattern // "Task.DAG.json"' "$OPENCODE_ROOT/$MACHINE_FILE")

    # 如果 Task.DAG.json 不在暂存区，跳过 TDD 校验（阶段1.5已处理联动）
    if ! echo "$changed_files" | grep -qF "$task_state_pattern"; then
        return 0
    fi

    echo -e "${BLUE}🔍 [Qoder/阶段3] 执行 TDD 分步提交校验...${NC}"

    local staged_tasks=$(git show ":$task_state_pattern" 2>/dev/null | jq -c '.tasks // []' || echo "[]")
    local head_tasks=$(git show "HEAD:$task_state_pattern" 2>/dev/null | jq -c '.tasks // []' || echo "[]")

    # 获取合法的 TDD 阶段标记
    local tdd_states="Red Green Refactor"

    for staged_task in $(echo "$staged_tasks" | jq -c '.[]'); do
        local task_id=$(echo "$staged_task" | jq -r '.id')
        local new_status=$(echo "$staged_task" | jq -r '.status')
        local old_task=$(echo "$head_tasks" | jq -c ".[] | select(.id == \"$task_id\")")

        if [ -z "$old_task" ]; then
            continue
        fi

        local old_status=$(echo "$old_task" | jq -r '.status')

        if [ "$old_status" = "$new_status" ]; then
            continue
        fi

        # 仅对 TDD 阶段（Red/Green/Refactor）执行分步校验
        local is_tdd_transition=false
        for tdd_state in $tdd_states; do
            if [ "$new_status" = "$tdd_state" ] || [ "$old_status" = "$tdd_state" ]; then
                is_tdd_transition=true
                break
            fi
        done

        if [ "$is_tdd_transition" = false ]; then
            continue
        fi

        echo -e "  → 任务 ${task_id}: ${old_status} → ${new_status}"

        # 规则 A：Red 状态下只允许提交测试文件
        if [ "$new_status" = "Red" ]; then
            local non_test_files=""
            while IFS= read -r file; do
                # 检查是否为业务代码（排除测试文件、配置、文档、Task.DAG.json、machine.json）
                if echo "$file" | grep -qE '\.ts$' && ! echo "$file" | grep -qE '(\.spec\.ts|\.test\.ts)'; then
                    # 排除非业务代码
                    if ! echo "$file" | grep -qE '(Task\.DAG\.json|machine\.json|machine\.schema\.json|\.d\.ts$)'; then
                        # 排除 seed 和 migration
                        if ! echo "$file" | grep -qE '(seed|migration)'; then
                            non_test_files="$non_test_files\n  - $file"
                        fi
                    fi
                fi
            done <<< "$changed_files"

            if [ -n "$non_test_files" ]; then
                echo -e "${RED}❌ [Qoder] 拒绝提交：任务 $task_id 处于 Red 状态，但提交包含非测试文件${NC}"
                echo -e "   Red 阶段仅允许提交测试文件 (*.spec.ts / *.test.ts)"
                echo -e "   以下文件不允许在 Red 阶段提交：$non_test_files"
                exit 1
            fi
        fi

        # 规则 B：commit message 必须包含 [Red]/[Green]/[Refactor] 标记
        local commit_msg=$(git log -1 --format='%s' 2>/dev/null)
        # 注意：pre-commit 阶段 commit 还未完成，需要从 MERGE_MSG 或自定义获取
        # 使用 git diff --cached 的方式推断意图不够可靠，改用环境变量或直接跳过此检查
        # 实际 commit message 在 commit-msg hook 中检查更合适
        # 这里先留接口，后续可在 commit-msg hook 中补充

        # 规则 C：Green 状态的转换必须存在先前的 Red commit
        if [ "$old_status" = "Red" ] && [ "$new_status" = "Green" ]; then
            # 检查 git log 中是否存在该 task_id 的 [Red] commit
            local red_commit=$(git log --oneline -20 2>/dev/null | grep -E "\[Red\].*$task_id" || true)
            if [ -z "$red_commit" ]; then
                echo -e "${YELLOW}⚠️  [Qoder/阶段3] 任务 $task_id: Red → Green 转换，但未在最近 20 条 commit 中找到 [Red] ${task_id} 标记${NC}"
                echo "   建议确认已先执行 Red 阶段提交"
                # 警告但不阻断，因为历史可能被 rebase
            fi
        fi
    done

    echo -e "${GREEN}✅ [Qoder/阶段3] TDD 分步提交校验通过${NC}"
}

# ============================================================================
# 阶段4: 合规门禁状态验证
# ============================================================================
phase4_gate_validation() {
    local gate_file="$OPENCODE_ROOT/.opencode/state/gate-state.json"

    if [ ! -f "$gate_file" ]; then
        echo -e "${YELLOW}⚠️ [Qoder/阶段4] gate-state.json 未找到，跳过合规门禁验证${NC}"
        return 0
    fi

    echo -e "${BLUE}🔍 [Qoder/阶段4] 执行合规门禁状态验证...${NC}"

    local gate_status
    gate_status=$(jq -r '.gate_status // "pending"' "$gate_file" 2>/dev/null || echo "unknown")

    if [ "$gate_status" != "armed" ]; then
        echo -e "${RED}❌ [Qoder/阶段4] 拒绝提交：合规门禁状态为 '${gate_status}'，而非 'armed'${NC}"
        echo ""
        echo -e "${YELLOW}   原因：${NC}业务代码提交必须通过合规门禁流程："
        echo "   1. agent 调用 compliance_gate_check（展示计划清单）"
        echo "   2. 用户确认计划后，agent 调用 compliance_gate_confirm"
        echo "   3. gate-state.json 中 gate_status 变为 'armed'"
        echo ""
        echo -e "${YELLOW}   解决方案：${NC}"
        echo "   1. 确保已展示 MCP/Skill 计划清单给用户"
        echo "   2. 获取用户确认后运行："
        local MCP_SCRIPT=$(read_config '.paths.mcp_gate_script' '.opencode/scripts/mcp-tools/compliance-gate.js')
        echo "      node ${OPENCODE_ROOT}/${MCP_SCRIPT} --confirm \"<task_id>\" \"<plan_summary>\""
        echo "   3. 重新提交"
        exit 1
    fi

    local confirmed_at
    confirmed_at=$(jq -r '.confirmed_at // "unknown"' "$gate_file" 2>/dev/null)
    echo -e "   ${GREEN}✅ 门禁状态: armed${NC}"
    echo -e "   ${GREEN}✅ 用户确认时间: ${confirmed_at}${NC}"
    echo -e "${GREEN}✅ [Qoder/阶段4] 合规门禁验证通过${NC}"
}

# ============================================================================
# 主流程
# ============================================================================
main() {
    check_dependencies
    load_contract_files

    if [ ! -f "$OPENCODE_ROOT/$MACHINE_FILE" ]; then
        echo -e "${YELLOW}⚠️ [Qoder] machine.json 未找到，跳过所有校验${NC}"
        exit 0
    fi

    phase0_schema_self_check
    phase1_contract_check
    phase1_5_task_dag_coupling
    phase2_task_lifecycle_check
    phase3_tdd_commit_check
    phase4_gate_validation

    echo -e "${GREEN}🎉 [Qoder] 所有物理约束校验通过，允许提交${NC}"
}

main

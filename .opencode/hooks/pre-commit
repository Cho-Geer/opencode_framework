#!/bin/bash
# Root repo pre-commit hook
# Delegates to the inner repo's keystone-validate tool.
# The inner repo (booking_system_refactor/) holds .opencode/state/ as the
# single source of truth and enforces all Keystone constraints.

set -e

ROOT="$(git rev-parse --show-toplevel)"
INNER="$ROOT/booking_system_refactor"
VALIDATOR="$INNER/scripts/keystone-validate.js"
MACHINE="$INNER/.opencode/state/machine.json"

if [ ! -f "$VALIDATOR" ]; then
    echo "⚠️  [Keystone] keystone-validate.js not found at $VALIDATOR — skipping validation"
    exit 0
fi

if [ ! -f "$MACHINE" ]; then
    echo "⚠️  [Keystone] machine.json not found at $MACHINE — no Keystone constraints active"
    exit 0
fi

echo "🔍 [Keystone] Running validation (delegated to inner repo)..."
node "$VALIDATOR" --pre-commit

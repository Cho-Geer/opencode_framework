// uc7ks-pipeline-db.ts — DB-Canonical UC7KS Pipeline State Management
// ═══════════════════════════════════════════════════════════════════════
// Replaces the substate_kv JSON blob + knowledge_discovery +
// knowledge_attestation row tables with a single unified DB table
// (uc7ks_pipeline_state).
//
// Key benefits:
//   1. Concurrency safety: SQLite UNIQUE(pipeline_id, agent, domain_id)
//      + UPSERT provides row-level locking, eliminating RMW races.
//   2. No key mismatch: pipeline_id is resolved identically in
//      search and attest (same session = same pipeline_id).
//   3. No field misread: direct column queries, no legacy fallback.
//   4. Full audit trail: every operation logged via writeLog.
//
// @see docs/review/framework-refactor/uc7ks-pipeline-db-canonical-design.md
// @author @Super-Admin
// @version 1.0.0
// @since 2026-06-23 (DB schema v19)
// ═══════════════════════════════════════════════════════════════════════

import { getDb } from "./db-manager";
import { writeLog } from "./log-manager";
import { resolveTaskId } from "./agent-resolver";

const SRC = "lib-uc7ks-pipeline-db";

// ── Types ──────────────────────────────────────────────────────────────

export interface CacheDiscovery {
  status: "undeclared" | "sufficient" | "insufficient";
  discovered_files: string[];
  missing_topics: string[];
  discovered_at: string;
}

export interface CacheAttestation {
  status: "unattested" | "attested" | "insufficient";
  cache_sufficient: boolean;
  files_read: string[];
  content_summary: string;
  attested_at: number;
}

export interface PipelineStateRow {
  pipeline_id: string;
  agent: string;
  domain_id: string;
  session_id: string | null;
  dag_task_id: string | null;
  discovery_status: string;
  discovered_files: string[];
  discovered_count: number;
  missing_topics: string[];
  discovered_at: number | null;
  attestation_status: string;
  cache_sufficient: boolean;
  files_read: string[];
  evidence_file_count: number;
  content_summary: string;
  attested_at: number | null;
  created_at: number;
  updated_at: number;
}

// ── Pipeline ID Resolution ─────────────────────────────────────────────

export function resolvePipelineId(
  args: { task_id?: string },
  sessionID?: string,
): string {
  if (args.task_id && args.task_id.trim() !== "") {
    return args.task_id;
  }
  const resolvedTaskId = resolveTaskId(sessionID);
  if (resolvedTaskId && resolvedTaskId !== "") {
    return resolvedTaskId;
  }
  if (sessionID && sessionID.trim() !== "") {
    return sessionID;
  }
  const uuid = generateUUID();
  writeLog(SRC, "WARN", {
    event: "UC7KS-PIPELINE-ID-FALLBACK-UUID",
    detail: "No task_id or sessionID available - generated UUID: " + uuid,
  });
  return uuid;
}

function generateUUID(): string {
  try {
    const crypto = require("node:crypto");
    if (typeof crypto.randomUUID === "function") {
      return crypto.randomUUID();
    }
  } catch {}
  const bytes = new Uint8Array(16);
  for (let i = 0; i < 16; i++) {
    bytes[i] = Math.floor(Math.random() * 256);
  }
  bytes[6] = (bytes[6] & 0x0f) | 0x40;
  bytes[8] = (bytes[8] & 0x3f) | 0x80;
  const hex = Array.from(bytes, (b) => b.toString(16).padStart(2, "0"));
  return hex.slice(0, 4).join("") + "-" + hex.slice(4, 6).join("") + "-" + hex.slice(6, 8).join("") + "-" + hex.slice(8, 10).join("") + "-" + hex.slice(10, 16).join("");
}

function normalizeAgentKey(agent: string): string {
  return (agent || "").replace(/^@/, "").toLowerCase();
}

// ── Discovery Phase ────────────────────────────────────────────────────

export function atomicUpsertDiscovery(params: {
  pipelineId: string;
  agent: string;
  domainId: string;
  sessionId?: string;
  dagTaskId?: string;
  discovery: CacheDiscovery;
}): boolean {
  const db = getDb();
  const startTime = Date.now();
  const normalizedAgent = normalizeAgentKey(params.agent);

  writeLog(SRC, "INFO", {
    event: "UC7KS-DISCOVERY-UPSERT-BEGIN",
    agent: params.agent,
    level: "INFO",
    pipeline_id: params.pipelineId,
    domain_id: params.domainId,
    session_id: params.sessionId || "-",
    file_count: params.discovery.discovered_files.length,
    status: params.discovery.status,
        detail: '${fix.event}',
  });

  try {
    db.run(
      "INSERT INTO uc7ks_pipeline_state (pipeline_id, agent, domain_id, session_id, dag_task_id, discovery_status, discovered_files, discovered_count, missing_topics, discovered_at, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, unixepoch('now') * 1000, unixepoch('now') * 1000) ON CONFLICT(pipeline_id, agent, domain_id) DO UPDATE SET discovery_status = excluded.discovery_status, discovered_files = excluded.discovered_files, discovered_count = excluded.discovered_count, missing_topics = excluded.missing_topics, discovered_at = excluded.discovered_at, session_id = excluded.session_id, dag_task_id = excluded.dag_task_id, updated_at = unixepoch('now') * 1000",
      [
        params.pipelineId,
        normalizedAgent,
        params.domainId,
        params.sessionId || null,
        params.dagTaskId || null,
        params.discovery.status,
        JSON.stringify(params.discovery.discovered_files),
        params.discovery.discovered_files.length,
        JSON.stringify(params.discovery.missing_topics),
        Date.now(),
      ],
    );

    const elapsed = Date.now() - startTime;
    writeLog(SRC, "INFO", {
      event: "UC7KS-DISCOVERY-UPSERT-OK",
      agent: params.agent,
      level: "INFO",
      pipeline_id: params.pipelineId,
      domain_id: params.domainId,
      elapsed_ms: elapsed,
      discovered_count: params.discovery.discovered_files.length,
        detail: '${fix.event}',
    });
    return true;
  } catch (err: any) {
    writeLog(SRC, "ERROR", {
      event: "UC7KS-DISCOVERY-UPSERT-FAILED",
      agent: params.agent,
      level: "ERROR",
      pipeline_id: params.pipelineId,
      domain_id: params.domainId,
      error: err.message,
        detail: '${fix.event}',
    });
    return false;
  }
}

// ── Discovery Read ─────────────────────────────────────────────────────

export function readDiscoveryForAttest(params: {
  pipelineId: string;
  agent: string;
  domainId: string;
}): CacheDiscovery | null {
  const db = getDb();
  const normalizedAgent = normalizeAgentKey(params.agent);

  writeLog(SRC, "DEBUG", {
    event: "UC7KS-READ-DISCOVERY",
    agent: params.agent,
    level: "DEBUG",
    pipeline_id: params.pipelineId,
    domain_id: params.domainId,
        detail: '${fix.event}',
  });

  const row = db
    .query("SELECT discovered_files, discovery_status, missing_topics, discovered_at FROM uc7ks_pipeline_state WHERE pipeline_id = ? AND agent = ? AND domain_id = ?")
    .get(params.pipelineId, normalizedAgent, params.domainId) as any;

  if (!row) {
    writeLog(SRC, "WARN", {
      event: "UC7KS-READ-DISCOVERY-NOT-FOUND",
      agent: params.agent,
      level: "WARN",
      pipeline_id: params.pipelineId,
      domain_id: params.domainId,
        detail: '${fix.event}',
    });
    return null;
  }

  let discoveredFiles: string[] = [];
  let missingTopics: string[] = [];
  try { discoveredFiles = JSON.parse(row.discovered_files || "[]"); } catch {}
  try { missingTopics = JSON.parse(row.missing_topics || "[]"); } catch {}

  writeLog(SRC, "INFO", {
    event: "UC7KS-READ-DISCOVERY-OK",
    agent: params.agent,
    level: "INFO",
    pipeline_id: params.pipelineId,
    domain_id: params.domainId,
    status: row.discovery_status,
    discovered_count: discoveredFiles.length,
        detail: '${fix.event}',
  });

  return {
    status: (row.discovery_status || "undeclared") as CacheDiscovery["status"],
    discovered_files: discoveredFiles,
    missing_topics: missingTopics,
    discovered_at: row.discovered_at ? new Date(row.discovered_at).toISOString() : new Date(0).toISOString(),
  };
}

// ── Attestation Phase ──────────────────────────────────────────────────

export function atomicUpsertAttestation(params: {
  pipelineId: string;
  agent: string;
  domainId: string;
  sessionId?: string;
  attestation: CacheAttestation;
}): boolean {
  const db = getDb();
  const normalizedAgent = normalizeAgentKey(params.agent);

  writeLog(SRC, "INFO", {
    event: "UC7KS-ATTESTATION-UPSERT-BEGIN",
    agent: params.agent,
    level: "INFO",
    pipeline_id: params.pipelineId,
    domain_id: params.domainId,
    status: params.attestation.status,
    file_count: params.attestation.files_read.length,
        detail: '${fix.event}',
  });

  try {
    const result = db.transaction(() => {
      const disc = db
        .query("SELECT discovery_status FROM uc7ks_pipeline_state WHERE pipeline_id = ? AND agent = ? AND domain_id = ?")
        .get(params.pipelineId, normalizedAgent, params.domainId) as any;

      if (!disc || disc.discovery_status !== "sufficient") {
        writeLog(SRC, "ERROR", {
          event: "UC7KS-ATTESTATION-GATE-FAILED",
          agent: params.agent,
          level: "ERROR",
          pipeline_id: params.pipelineId,
          domain_id: params.domainId,
          discovery_status: disc?.discovery_status || "missing",
        detail: '${fix.event}',
        });
        return false;
      }

      db.run(
        "UPDATE uc7ks_pipeline_state SET attestation_status = ?, cache_sufficient = ?, files_read = ?, evidence_file_count = ?, content_summary = ?, attested_at = ?, updated_at = unixepoch('now') * 1000 WHERE pipeline_id = ? AND agent = ? AND domain_id = ?",
        [
          params.attestation.status,
          params.attestation.cache_sufficient ? 1 : 0,
          JSON.stringify(params.attestation.files_read),
          params.attestation.files_read.length,
          params.attestation.content_summary,
          params.attestation.attested_at,
          params.pipelineId,
          normalizedAgent,
          params.domainId,
        ],
      );

      writeLog(SRC, "INFO", {
        event: "UC7KS-ATTESTATION-UPSERT-OK",
        agent: params.agent,
        level: "INFO",
        pipeline_id: params.pipelineId,
        domain_id: params.domainId,
        status: params.attestation.status,
        detail: '${fix.event}',
      });
      return true;
    })();
    return result;
  } catch (err: any) {
    writeLog(SRC, "ERROR", {
      event: "UC7KS-ATTESTATION-UPSERT-FAILED",
      agent: params.agent,
      level: "ERROR",
      pipeline_id: params.pipelineId,
      domain_id: params.domainId,
      error: err.message,
        detail: '${fix.event}',
    });
    return false;
  }
}

// ── Write Gate Query ───────────────────────────────────────────────────

export function queryAttestationForWriteGate(params: {
  pipelineId: string;
  agent: string;
  domainId: string;
}): { attestation_status: string; cache_sufficient: boolean; files_read: string[] } | null {
  const db = getDb({ skipSchema: true });
  const normalizedAgent = normalizeAgentKey(params.agent);

  const row = db
    .query("SELECT attestation_status, cache_sufficient, files_read FROM uc7ks_pipeline_state WHERE pipeline_id = ? AND agent = ? AND domain_id = ?")
    .get(params.pipelineId, normalizedAgent, params.domainId) as any;

  if (!row) return null;

  let filesRead: string[] = [];
  try { filesRead = JSON.parse(row.files_read || "[]"); } catch {}

  return {
    attestation_status: row.attestation_status || "unattested",
    cache_sufficient: row.cache_sufficient === 1,
    files_read: filesRead,
  };
}

// ── Full Row Query ─────────────────────────────────────────────────────

export function readPipelineState(params: {
  pipelineId: string;
  agent: string;
  domainId: string;
}): PipelineStateRow | null {
  const db = getDb({ skipSchema: true });
  const normalizedAgent = normalizeAgentKey(params.agent);

  const row = db
    .query("SELECT * FROM uc7ks_pipeline_state WHERE pipeline_id = ? AND agent = ? AND domain_id = ?")
    .get(params.pipelineId, normalizedAgent, params.domainId) as any;

  if (!row) return null;

  let discoveredFiles: string[] = [];
  let missingTopics: string[] = [];
  let filesRead: string[] = [];
  try { discoveredFiles = JSON.parse(row.discovered_files || "[]"); } catch {}
  try { missingTopics = JSON.parse(row.missing_topics || "[]"); } catch {}
  try { filesRead = JSON.parse(row.files_read || "[]"); } catch {}

  return {
    pipeline_id: row.pipeline_id,
    agent: row.agent,
    domain_id: row.domain_id,
    session_id: row.session_id,
    dag_task_id: row.dag_task_id,
    discovery_status: row.discovery_status,
    discovered_files: discoveredFiles,
    discovered_count: row.discovered_count,
    missing_topics: missingTopics,
    discovered_at: row.discovered_at,
    attestation_status: row.attestation_status,
    cache_sufficient: row.cache_sufficient === 1,
    files_read: filesRead,
    evidence_file_count: row.evidence_file_count,
    content_summary: row.content_summary,
    attested_at: row.attested_at,
    created_at: row.created_at,
    updated_at: row.updated_at,
  };
}
// ── All-Domain Query (Path C) ─────────────────────────────────────────

/** Lightweight row for multi-domain attestation check in Path C */
export interface PipelineDomainSummary {
  domain_id: string;
  attestation_status: string;
  cache_sufficient: boolean;
}

/**
 * Query all domains for a given pipeline_id + agent.
 * Used by checkUC7KSWrite Path C for all-domain attestation verification.
 * Replaces JSON blob read via readCachedSessionAccess() + readCacheAttestation().
 */
export function queryAllAgentPipelineDomains(params: {
  pipelineId: string;
  agent: string;
}): PipelineDomainSummary[] {
  const db = getDb({ skipSchema: true });
  const normalizedAgent = normalizeAgentKey(params.agent);

  writeLog(SRC, "DEBUG", {
    event: "UC7KS-QUERY-ALL-DOMAINS",
    agent: params.agent,
    level: "DEBUG",
    pipeline_id: params.pipelineId,
        detail: '${fix.event}',
  });

  try {
    const rows = db
      .query(
        "SELECT domain_id, attestation_status, cache_sufficient FROM uc7ks_pipeline_state WHERE pipeline_id = ? AND agent = ?",
      )
      .all(params.pipelineId, normalizedAgent) as any[];

    if (!rows || rows.length === 0) {
      writeLog(SRC, "WARN", {
        event: "UC7KS-QUERY-ALL-DOMAINS-EMPTY",
        agent: params.agent,
        level: "WARN",
        pipeline_id: params.pipelineId,
        detail: "No domains found for this pipeline + agent",
      });
      return [];
    }

    writeLog(SRC, "INFO", {
      event: "UC7KS-QUERY-ALL-DOMAINS-OK",
      agent: params.agent,
      level: "INFO",
      pipeline_id: params.pipelineId,
      domain_count: rows.length,
        detail: '${fix.event}',
    });

    return rows.map((row: any) => ({
      domain_id: row.domain_id,
      attestation_status: row.attestation_status || "unattested",
      cache_sufficient: row.cache_sufficient === 1,
    }));
  } catch (err: any) {
    writeLog(SRC, "ERROR", {
      event: "UC7KS-QUERY-ALL-DOMAINS-FAILED",
      agent: params.agent,
      level: "ERROR",
      pipeline_id: params.pipelineId,
      error: err.message,
        detail: '${fix.event}',
    });
    return [];
  }
}


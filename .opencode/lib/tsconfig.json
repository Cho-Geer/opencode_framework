{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node10",
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "types": ["node"]
  },
  "include": [
    "state-manager.ts",
    "state-compactor.ts",
    "log-rotator.ts",
    "dag-version-manager.ts"
  ],
  "exclude": [
    "dist",
    "__tests__",
    "node_modules"
  ]
}

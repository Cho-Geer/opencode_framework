{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": ".",
    "declaration": false,
    "noEmit": false
  },
  "include": ["framework-enforcer.ts"],
  "exclude": ["node_modules"]
}

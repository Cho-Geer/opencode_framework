import type { Plugin, PluginInput, Hooks } from "@opencode-ai/plugin"
import {
  makeSafeEditTool,
  makeSafeBashTool,
  makeSafeTestTool,
} from "../../tools/tool-definitions.js"

const plugin: Plugin = async (_ctx: PluginInput): Promise<Hooks> => {
  return {
    tool: {
      safe_edit: makeSafeEditTool(),
      safe_bash: makeSafeBashTool(),
      safe_test: makeSafeTestTool(),
    },
  }
}

export default plugin

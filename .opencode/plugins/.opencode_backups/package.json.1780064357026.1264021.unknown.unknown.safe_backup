{
  "name": "@opencode/framework-enforcer",
  "version": "1.0.0",
  "description": "OpenCode Framework Enforcer Plugin — enforces DAG/gate/compliance at runtime via tool.execute.before and shell.env hooks",
  "main": "framework-enforcer/framework-enforcer.ts",
  "type": "module",
  "scripts": {
    "build": "cd framework-enforcer && npx tsc",
    "check": "cd framework-enforcer && npx tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "plugin",
    "framework",
    "enforcer",
    "compliance"
  ],
  "author": "@Architect",
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.9.3"
  }
}

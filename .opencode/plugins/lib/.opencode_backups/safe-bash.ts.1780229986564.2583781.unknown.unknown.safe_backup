import { execSync } from "node:child_process";
import * as fs from "node:fs";
import * as path from "node:path";

/**
 * Safe Bash Tool - Allowlisted shell command execution
 * Hardened constraint: Only allowlisted commands may execute
 */

// ═══════════════════════════════════════════════════════════════════
// TYPES / INTERFACES
// ═══════════════════════════════════════════════════════════════════

/** Result of a safe bash command execution */
export interface SafeBashResult {
  command: string;
  agent: string;
  allowed: boolean;
  executed: boolean;
  exitCode: number | null;
  stdout: string;
  stderr: string;
  blockedReason: string | null;
  timestamp: string;
}

/** Options for safeBashTool */
export interface SafeBashOptions {
  command: string;
  timeout?: number;
  dryRun?: boolean;
  agent?: string;
}

// ═══════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════


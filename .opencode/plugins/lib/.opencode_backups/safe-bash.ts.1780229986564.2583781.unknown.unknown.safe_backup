  /curl\s+.*\|\s*sh/i, // No pipe to shell
  /wget\s+.*\|\s*sh/i, // No pipe to shell
  /eval\s*\(/i, // No eval
  /exec\s*\(/i, // No exec
  /child_process/i, // No child_process in child_process
  /require\s*\(\s*['"]http['"]\s*\)/i, // No HTTP requests
  /require\s*\(\s*['"]https['"]\s*\)/i, // No HTTPS requests
];


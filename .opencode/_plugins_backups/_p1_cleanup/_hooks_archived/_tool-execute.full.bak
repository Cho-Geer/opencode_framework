/**
 * hooks/tool-execute.ts — Tool Execution Hooks (Before/After)
 *
 * Extracted from framework-enforcer.ts §FW-HARNESS (lines 515-1316, ~771 lines).
 * The core enforcement engine — handles all pre/post tool execution checks.
 *
 * FUNCTIONS:
 *   - toolExecuteBefore()       — Pre-execution: DAG coverage, gate state, permission
 *                                 isolation, dispatch token, write scopes, TDD enforcement,
 *                                 dangerous command audit, scope escalation, plugin integrity,
 *                                 rule registry, machine cleanliness,
 *                                 UC7KS pipeline (UC7-001 proactive write block,
 *                                 UC7-005 size cap, UC7-008 @KC scope isolation,
 *                                 UC7-001/002/004/009 external query blocking)
 *   - toolExecuteAfter()        — Post-execution: audit logging, stale session detection,
 *                                 auto-drain, state reconciliation, write-audit auto-trigger,
 *                                 knowledge_state auto-sync, UC7-003 docs save verification
 *   - _executeWriteAuditCheck() — Internal: debounced write-time quality check auto-trigger
 *
 * DEPENDS ON (all already extracted):
 *   - utils/state-utils.ts
 *   - utils/audit-log.ts
 *   - checks/gate-checks.ts
 *
 * STATUS: ✅ EXTRACTED + UC7KS-HARDENED — 7/7 modules complete.
 *         FW-REPAIR-UC7KS: T-H05, UC7-005, UC7-008 migrated from monolith.
 *
 * @since Wave 3.1 (R5)
 * @since 2026-06-06 — UC7KS structural gap fixes (FW-REPAIR-UC7KS)
 */

import * as fs from "node:fs";
import * as path from "node:path";
import * as crypto from "node:crypto";
import { createRequire } from "node:module";
import { PermissionIsolation } from "../../../lib/permission-isolation-core";
import { readJsonFile, findArmedSession, findAnyGateSession, getEnforcementMode } from "../../../lib/gate-core";
import { computeSHA256 } from "../../../lib/gate-core";
import {
  getOpenCodeRoot, STATE_PATHS, isSourceFile, isStaleSession, isCriticalFrameworkFile,
} from "../utils/state-utils";
import {
  writeAuditLogEntry, logAuditEntry,
} from "../utils/audit-log";
import {
  checkPluginIntegrity, findTaskInDag, isWriteAllowed, checkStaleSessions,
  autoDrainStaleSessions, checkRuleRegistryIntegrity, checkMachineCleanliness,
} from "../checks/gate-checks";

// Debounce state for write-time checks
let _lastWriteCheckTime = 0;
let _pendingWriteChecks: string[] = [];
const WRITE_CHECK_DEBOUNCE_MS = 2000;

// ── UC7KS constants (merged from uc7ks-enforcer.ts) ──
const UC7KS_INDEX_PATH = "docs/official_docs/index.json";
const UC7KS_DOCS_ROOT = "docs/official_docs/";
const EXTERNAL_DOC_TOOLS = new Set([
  "context7_resolve-library-id", "context7_query-docs", "context7",
  "webfetch", "websearch",
]);
const UC7KS_BYPASS_AGENTS = new Set(["Knowledge-Curator", "@Knowledge-Curator"]);

/**
 * UC7-009: Knowledge Cache Health Check (GAP-C1 remediation)
 *
 * Determines if the UC7KS knowledge cache is in a healthy state.
 * "Healthy" means `docs/official_docs/index.json` exists, is valid JSON,
 * and contains at least one entry. This function is used by the
 * Super-Admin conditional emergency bypass: when the cache is unhealthy
 * (missing, corrupt, or empty), Super-Admin is allowed to bypass UC7-001
 * write blocks to perform emergency repairs. When the cache is healthy,
 * Super-Admin undergoes the same UC7-001 enforcement as all other agents.
 *
 * @returns true if the knowledge cache is available and populated
 * @since 2026-06-06 — GAP-C1 remediation, UC7-009 enforcement
 */
function isKnowledgeCacheHealthy(): boolean {
  try {
    const indexPath = path.resolve(getOpenCodeRoot(), "docs", "official_docs", "index.json");
    if (!fs.existsSync(indexPath)) return false;
    const raw = fs.readFileSync(indexPath, "utf8");
    if (!raw.trim()) return false;
    const index = JSON.parse(raw);
    return !!(index.manifest_version && Array.isArray(index.entries) && index.entries.length > 0);
  } catch {
    return false;
  }
}

/**
 * Build a structured UC7KS pipeline error message with ASCII art.
 * Points the agent to the correct remediation path.
 *
 * @param agent - The agent that attempted the blocked call
 * @param tool - The tool that was blocked
 * @param mode - Current enforcement mode
 * @param cacheAvailable - Whether local cache is available
 * @param reason - Specific reason for blocking
 */
function uc7ksBuildError(
  agent: string, tool: string, mode: string,
  cacheAvailable: boolean, reason: string,
): string {
  const lines = [
    ``,
    `╔══════════════════════════════════════════════════════════════╗`,
    `║  UC7KS PIPELINE ENFORCEMENT — ${mode.toUpperCase()} MODE                      ║`,
    `╠══════════════════════════════════════════════════════════════╣`,
    `║  Tool blocked: ${tool.padEnd(44)} ║`,
    `║  Agent:        ${(agent || "unknown").padEnd(44)} ║`,
    `║  Reason:       ${reason.padEnd(44)} ║`,
    `║  Cache status: ${(cacheAvailable ? "AVAILABLE (must search first)" : "NOT INITIALIZED").padEnd(44)} ║`,
    `╠══════════════════════════════════════════════════════════════╣`,
    `║  REQUIRED REMEDIATION:                                      ║`,
    `║  1. Search local cache: read docs/official_docs/index.json  ║`,
    `║  2. If insufficient: request @Orchestrator to dispatch      ║`,
    `║     @Knowledge-Curator to fetch the needed documents        ║`,
    `║  3. Wait for @Knowledge-Curator to complete caching         ║`,
    `║  4. Re-read the cached documents from docs/official_docs/   ║`,
    `║  5. Proceed with task using LOCALLY CACHED knowledge        ║`,
    `║                                                            ║`,
    `║  VIOLATION: UC7-001 (local-first), UC7-004 (no direct      ║`,
    `║  Context7), UC7-009 (all agents must follow UC7KS)          ║`,
    `╚══════════════════════════════════════════════════════════════╝`,
    ``,
  ];
  return lines.join("\n");
}

export async function toolExecuteBefore(
  input: { tool: string; sessionID: string; callID: string },
  output: { args: Record<string, unknown> },
): Promise<void> {
  const tool = input.tool;
  const mode = getEnforcementMode();
  const violations: string[] = [];
  const agent = process.env.FRAMEWORK_AGENT || "";
  const taskId = process.env.FRAMEWORK_TASK_ID || "";

  // P0: Orchestrator DAG modification block
  if ((tool === "write" || tool === "edit" || tool === "safe_edit") && (agent === "Orchestrator" || agent === "@Orchestrator")) {
    const filePath = (output.args?.filePath as string) || "";
    if (filePath.endsWith("Task.DAG.json")) {
      throw new Error("[FW-ENFORCE][LOCKED] Orchestrator modification of Task.DAG.json blocked. Only @Meta-Planner may modify the DAG.");
    }
  }

  // P0: Permission isolation check
  const PERMISSION_MANAGED_TOOLS = new Set(["edit", "bash", "task"]);
  if (agent && PERMISSION_MANAGED_TOOLS.has(tool)) {
    const pi = new PermissionIsolation();
    const permResult = await pi.checkPermission(agent, tool);
    if (!permResult.allowed) {
      const msg = `[FW-ENFORCE] Permission denied: agent '${agent}' cannot use tool '${tool}'. Reason: ${permResult.reason}`;
      console.error(msg);
      if (mode !== "advisory") throw new Error(msg);
    }
  }

  // P0: Orchestrator Mandatory Dispatch Gate
  if (agent === "Orchestrator" || agent === "@Orchestrator") {
    const ORCHESTRATOR_ALLOWED_TOOLS = ["task", "read", "todowrite", "compliance_gate_check", "compliance_gate_confirm", "compliance_gate_complete", "dispatch_subagent"];
    if (!ORCHESTRATOR_ALLOWED_TOOLS.includes(tool)) {
      throw new Error(`[FW-ENFORCE][FATAL] Orchestrator DISPATCH GATE BLOCKED: tool "${tool}" not allowed.`);
    }
    if (tool === "task") {
      const promptText = (output.args?.prompt || output.args?.description || "") as string;
      const tokenMarker = "//DISPATCH_TOKEN:";
      const tokenIndex = promptText.lastIndexOf(tokenMarker);
      if (tokenIndex === -1) throw new Error("[FW-ENFORCE][FATAL] Orchestrator Task() DISPATCH TOKEN MISSING.");
      const actualHash = promptText.substring(tokenIndex + tokenMarker.length).trim().split("\n")[0];
      const promptWithoutToken = promptText.substring(0, tokenIndex);
      const expectedHash = crypto.createHash("sha256").update(promptWithoutToken, "utf8").digest("hex");
      if (actualHash !== expectedHash) throw new Error(`[FW-ENFORCE][FATAL] DISPATCH TOKEN MISMATCH.`);
    }
  }

  // P0: Coder-BE/FE block framework writes
  const coderAgent = agent === "Coder-BE" || agent === "@Coder-BE" || agent === "Coder-FE" || agent === "@Coder-FE";
  if ((tool === "write" || tool === "edit" || tool === "safe_edit") && coderAgent) {
    const fp = (output.args?.filePath as string) || "";
    if (fp.includes(".opencode/")) throw new Error(`[FW-ENFORCE][LOCKED] ${agent} framework write blocked.`);
  }
  if (tool === "safe_bash" && coderAgent) {
    const cmd = (output.args?.command as string) || "";
    const WRITE_PATTERNS = [/\s+>\s*\.opencode\//, /\s+>>\s*\.opencode\//, /rm\s+.*\.opencode\//, /cp\s+.*\.opencode\//, /mv\s+.*\.opencode\//, /mkdir\s+.*\.opencode\//, /tee\s+.*\.opencode\//, /node\s+-e\s+.*\.opencode\//];
    if (WRITE_PATTERNS.some(p => p.test(cmd))) throw new Error(`[FW-ENFORCE][LOCKED] ${agent} safe_bash framework write blocked.`);
  }

  /**
   * UC7-009: Super-Admin UC7KS compliance (GAP-C1 remediation)
   *
   * Previously Super-Admin returned unconditionally at this point,
   * bypassing ALL enforcement checks including UC7-001 (knowledge cache
   * read requirement). Per UC7-009 ("MUST follow the same UC7KS
   * pipeline"), this unconditional bypass is removed.
   *
   * Super-Admin now proceeds through the same enforcement pipeline
   * as all other agents. The UC7-001 write-time check (below) handles
   * the conditional emergency bypass: when the knowledge cache is
   * UNHEALTHY, Super-Admin may write without UC7-001 compliance
   * (emergency repair context with full audit logging). When the
   * cache is HEALTHY, UC7-001 is fully enforced for Super-Admin.
   *
   * @since 2026-06-06 — GAP-C1 remediation, UC7-009 enforcement
   */
  const isSuperAdmin = agent === "Super-Admin" || agent === "@Super-Admin";
  if (isSuperAdmin) {
    logAuditEntry({
      event: "super_admin_uc7_009_enforcement",
      tool, sessionID: input.sessionID,
      detail: `Super-Admin invoked "${tool}" — UC7-009 enforcement active (conditional emergency bypass at UC7-001 block)`,
    });
  }

  // P0: Architect block business code + sensitive framework writes
  if ((tool === "write" || tool === "edit" || tool === "safe_edit") && (agent === "Architect" || agent === "@Architect")) {
    const fp = (output.args?.filePath as string) || "";
    if (fp.includes("booking_system_refactor/booking-backend/src/") || fp.includes("booking_system_refactor/booking-frontend/src/")) {
      throw new Error("[FW-ENFORCE][LOCKED] Architect business code write blocked.");
    }
    if (fp.includes(".opencode/") && !fp.includes(".opencode/context/") && !fp.includes(".opencode/state/machine.json") && !fp.includes("contract.yaml") && !fp.includes("docs/") && !fp.includes(".task_temp/")) {
      throw new Error("[FW-ENFORCE][LOCKED] Architect framework infrastructure write blocked.");
    }
  }

  // === UC7KS: UC7-001 — Proactive Write/Edit/Bash Block (T-H05 migration) ===
  // FW-HARDEN-UC7KS-002: Blocks agents from writing code or executing shell
  // commands if they have NOT completed UC7-001 (read the knowledge cache).
  // This closes the gap between the doc query pipeline (enforced by
  // uc7ks-enforcer.ts) and the code write pipeline.
  //
  // @Knowledge-Curator is exempt (it IS the pipeline).
  // @Super-Admin: UC7-009 enforcement active. Conditional emergency bypass
  //   below — allowed only when knowledge cache is UNHEALTHY (missing or
  //   corrupt). When cache is HEALTHY, Super-Admin undergoes same UC7-001
  //   check as all other agents. (GAP-C1 remediation, 2026-06-06)
  //
  // Enforcement:
  //   advisory: Log warning only (non-blocking)
  //   strict:   BLOCK if uc7_001_compliant is not true
  //   locked:   BLOCK if uc7_001_compliant is not true
  if ((tool === "write" || tool === "edit" || tool === "safe_edit" || tool === "bash" || tool === "safe_shell") &&
      agent && agent !== "Knowledge-Curator" && agent !== "@Knowledge-Curator") {
    try {
      const machinePath = STATE_PATHS.machine();
      const machine = readJsonFile<any>(machinePath);
      const kcs = machine?.knowledge_cache_state;
      const agentState = kcs?.session_access?.[agent];
      const isCompliant = agentState?.uc7_001_compliant === true;

      if (!isCompliant) {
        /**
         * UC7-009: Super-Admin Conditional Emergency Bypass (GAP-C1 remediation)
         *
         * Super-Admin is the emergency framework repair agent. If the
         * knowledge cache is unhealthy (missing or corrupt index.json),
         * blocking Super-Admin from writing would create a circular
         * dependency deadlock — the agent that can fix the cache cannot
         * write because the cache is broken.
         *
         * In strict/locked mode: when the cache is unhealthy, Super-Admin
         * is allowed to bypass UC7-001 with full audit logging. When the
         * cache IS healthy, Super-Admin undergoes normal enforcement.
         *
         * In advisory mode: same behavior as other agents (warning only).
         */
        if (isSuperAdmin && !isKnowledgeCacheHealthy()) {
          const filePath = (output.args?.filePath as string) || "N/A";
          const bypassMsg =
            `[FW-ENFORCE][UC7-001][SUPER-ADMIN-EMERGENCY] Super-Admin ` +
            `conditional bypass: knowledge cache is unhealthy, allowing ` +
            `"${tool}" on "${filePath}". Emergency repair context — ` +
            `UC7-009 conditional bypass (GAP-C1). ` +
            `Cache will be validated once repaired.`;
          console.warn(bypassMsg);
          logAuditEntry({
            event: "uc7ks_super_admin_emergency_bypass",
            tool, agent, sessionID: input.sessionID,
            detail: `Super-Admin emergency bypass: cache unhealthy (isKnowledgeCacheHealthy=false), ` +
              `allowed "${tool}" on "${filePath}". UC7-009 conditional.`,
          });
          // Allow the write — emergency repair in progress
        } else {
          // Normal enforcement for all agents (including Super-Admin when cache is healthy)
          const blockedAgent = isSuperAdmin
            ? `${agent} [cache healthy — UC7-009 enforced]`
            : agent;
          const msg = `[FW-ENFORCE][UC7-001][PROACTIVE] Agent "${blockedAgent}" blocked on tool "${tool}": ` +
            `knowledge cache not searched (UC7-001 not satisfied). ` +
            `Required: read docs/official_docs/index.json (Step 0b) before writing code. ` +
            `Refer to subagent-preamble.md §Step 0a-0c.`;

          if (mode === "strict" || mode === "locked") {
            console.error(msg);
            throw new Error(msg);
          }
          // advisory: log warning, allow execution
          console.warn(`[FW-ENFORCE][UC7-001][ADVISORY] ${msg} (non-blocking in advisory mode)`);
          logAuditEntry({
            event: "uc7ks_uc7_001_proactive_block",
            tool, agent, sessionID: input.sessionID,
            detail: `Agent "${agent}" blocked on "${tool}" — uc7_001_compliant=${isCompliant}`,
          });
        }
      }
    } catch (e: any) {
      if (e.message?.includes("UC7-001")) throw e; // Re-throw enforcement errors
      // Non-fatal: machine.json read failure should not block the agent
      console.warn(`[FW-ENFORCE][UC7-001] Failed to verify knowledge cache state: ${e.message?.slice(0, 100)}`);
    }
  }

  // === UC7KS: UC7-008 — @Knowledge-Curator Scope Isolation ===
  // FW-HARDEN-UC7KS-005: Restricts @Knowledge-Curator writes to the knowledge
  // cache directory (docs/official_docs/) and metadata (.metadata/).
  // Complements opencode.json permission-level restrictions with code-level
  // throw Error enforcement.
  //
  // Enforcement:
  //   advisory: Log warning only
  //   strict:   BLOCK writes outside allowed scope
  //   locked:   BLOCK writes outside allowed scope
  if ((tool === "write" || tool === "edit" || tool === "safe_edit") &&
      (agent === "Knowledge-Curator" || agent === "@Knowledge-Curator")) {
    const filePath = (output.args?.filePath as string) || "";
    const KC_ALLOWED_PREFIXES = ["docs/official_docs/", ".metadata/"];
    const isAllowed = KC_ALLOWED_PREFIXES.some(prefix => filePath.includes(prefix));

    if (!isAllowed) {
      const msg = `[FW-ENFORCE][UC7-008] @Knowledge-Curator scope violation: attempted write to "${filePath}". ` +
        `@KC may only write to docs/official_docs/** and .metadata/**.`;

      if (mode === "strict" || mode === "locked") {
        console.error(msg);
        throw new Error(msg);
      }
      // advisory
      console.warn(`[FW-ENFORCE][UC7-008][ADVISORY] ${msg} (non-blocking in advisory mode)`);
      logAuditEntry({
        event: "uc7ks_uc7_008_violation",
        tool, agent, sessionID: input.sessionID,
        detail: `@KC attempted write to restricted path: ${filePath}`,
      });
    }
  }

  // === UC7KS: UC7-005 — Knowledge Cache File Size Cap (500KB) ===
  // FW-HARDEN-UC7KS-006: Prevents oversized files (>500KB / 524288 bytes)
  // from being written to the knowledge cache. Blocks cache bloat and
  // ensures reasonable context window usage for consuming agents.
  //
  // NOTE: For safe_edit patch mode, newString may not represent full file
  // content. This is a pre-write approximate check; the post-write full-file
  // verification is handled by uc7ks-enforcer.ts tool.execute.after (UC7-003).
  //
  // Enforcement:
  //   advisory: Log warning only
  //   strict:   BLOCK writes exceeding 500KB
  //   locked:   BLOCK writes exceeding 500KB
  if ((tool === "write" || tool === "edit" || tool === "safe_edit")) {
    const filePath = (output.args?.filePath as string) || "";
    if (filePath.includes("docs/official_docs/")) {
      const content = (output.args?.content || output.args?.newString || "") as string;
      const sizeBytes = Buffer.byteLength(content, "utf8");
      const MAX_FILE_SIZE = 524288; // 500KB per UC7-005

      if (sizeBytes > MAX_FILE_SIZE) {
        const msg = `[FW-ENFORCE][UC7-005] File size cap exceeded: ${filePath} is ` +
          `${(sizeBytes / 1024).toFixed(1)}KB (max 500KB per UC7-005). ` +
          `Split or compress before saving.`;

        if (mode === "strict" || mode === "locked") {
          console.error(msg);
          throw new Error(msg);
        }
        // advisory
        console.warn(`[FW-ENFORCE][UC7-005][ADVISORY] ${msg} (non-blocking in advisory mode)`);
        logAuditEntry({
          event: "uc7ks_uc7_005_violation",
          tool, agent, sessionID: input.sessionID,
          detail: `${filePath}: ${sizeBytes} bytes`,
        });
      }
    }
  }

  // ── UC7KS External Query Enforcement (UC7-001/002/004/009) ──
  // Merged from uc7ks-enforcer.ts. Intercepts webfetch/websearch/context7_* tools.
  // For all other tools, EXTERNAL_DOC_TOOLS.has(tool) is false → no-op.
  if (EXTERNAL_DOC_TOOLS.has(tool)) {
    const uc7ksAgent = process.env.FRAMEWORK_AGENT || "";
    const dispatchContext = process.env.FRAMEWORK_DISPATCH_CONTEXT || "";

    // Dispatch-bypass detection (no FRAMEWORK_AGENT set)
    if (dispatchContext === "orchestrated" && !uc7ksAgent) {
      console.error(`[FW-Enforcer][AGENT-001] Dispatch bypass: unidentified agent attempting "${tool}".`);
      if (mode !== "advisory") {
        throw new Error(uc7ksBuildError("(unknown)", tool, mode, isKnowledgeCacheHealthy(),
          "AGENT-001: Dispatch bypass. FRAMEWORK_AGENT not set."));
      }
      console.warn(`[FW-Enforcer][AGENT-001][ADVISORY] Dispatch bypass with "${tool}" — allowing in advisory.`);
    }

    // @Knowledge-Curator bypass
    if (UC7KS_BYPASS_AGENTS.has(uc7ksAgent)) {
      console.log(`[FW-Enforcer][UC7-009] Bypass: "${uc7ksAgent}" is the knowledge curator. Allowing "${tool}".`);
    } else {
      const uc7ksCacheAvailable = isKnowledgeCacheHealthy();

      // UC7-001: Verify agent read local cache
      let agentHasReadCache = false;
      try {
        const mp = readJsonFile<any>(STATE_PATHS.machine());
        agentHasReadCache = !!(mp?.knowledge_cache_state?.session_access?.[uc7ksAgent]?.uc7_001_compliant);
      } catch { /* non-fatal */ }

      if (!agentHasReadCache && uc7ksCacheAvailable) {
        console.error(`[FW-Enforcer][UC7-001][HARD-BLOCK] Agent "${uc7ksAgent}" external query "${tool}" blocked.`);
        throw new Error(uc7ksBuildError(uc7ksAgent, tool, mode, true,
          "UC7-001: Agent has not read the local knowledge cache."));
      }

      // UC7-001b: Cache sufficiency declared? (strict/locked)
      if (agentHasReadCache && uc7ksCacheAvailable && mode !== "advisory") {
        try {
          const mp2 = readJsonFile<any>(STATE_PATHS.machine());
          const sufficiency = mp2?.knowledge_cache_state?.session_access?.[uc7ksAgent]?.cache_sufficiency?.status;
          if (sufficiency !== "sufficient" && sufficiency !== "insufficient") {
            throw new Error(uc7ksBuildError(uc7ksAgent, tool, mode, true,
              `UC7-001b: Cache sufficiency not declared (status: ${sufficiency || "undeclared"}). See subagent-preamble.md Step 0c.`));
          }
        } catch (e: any) {
          if (e.message?.includes("UC7-001b")) throw e;
        }
      }

      // Mode-based gating
      if (mode === "advisory") {
        if (uc7ksCacheAvailable) {
          console.warn(`[FW-Enforcer][UC7-001][ADVISORY] Agent "${uc7ksAgent}" should check cache before "${tool}".`);
        }
        console.warn(`[FW-Enforcer][UC7-002][ADVISORY] External query "${tool}" — verify user confirmation.`);
      } else if (mode === "strict") {
        if (uc7ksCacheAvailable) {
          throw new Error(uc7ksBuildError(uc7ksAgent, tool, "strict", true,
            "Local cache exists. Must search before external queries."));
        }
        console.log(`[FW-Enforcer][UC7-001][STRICT] Cache not initialized. Allowing first-time query.`);
      } else if (mode === "locked") {
        throw new Error(uc7ksBuildError(uc7ksAgent, tool, "locked", uc7ksCacheAvailable,
          "LOCKED: All direct external queries blocked. Use @Knowledge-Curator."));
      }
    }
  }

  // Docs consistency check
  if ((tool === "write" || tool === "edit" || tool === "safe_edit") && (agent === "Coder-BE" || agent === "@Coder-BE" || agent === "Coder-FE" || agent === "@Coder-FE")) {
    const fp = (output.args?.filePath as string) || "";
    if (fp && isSourceFile(fp) && taskId) {
      const logPath = path.resolve(getOpenCodeRoot(), ".task_temp", taskId, "TASK_LOG.md");
      if (fs.existsSync(logPath)) {
        try {
          const logContent = fs.readFileSync(logPath, "utf8");
          if (!/##\s*📄\s*Docs Consistency Report/.test(logContent)) {
            const msg = "[FW-ENFORCE][BLOCKED] Docs Consistency Report missing from TASK_LOG.md.";
            if (mode === "strict" || mode === "locked") throw new Error(msg);
            logAuditEntry({ event: "docs_consistency_advisory", agent, filePath: fp, taskId, detail: msg });
          }
        } catch (_e) { /* skip */ }
      }
    }
  }

  // Plugin integrity check
  const integrityResult = checkPluginIntegrity();
  if (!integrityResult.valid) {
    if (mode === "strict" || mode === "locked") throw new Error(`[FW-ENFORCE] Plugin integrity violation: ${integrityResult.detail}`);
    logAuditEntry({ event: "silent_audit", detail: `[FW-ENFORCE][WARN][${mode}] Plugin integrity: ${integrityResult.detail}` });
  }

  // DAG coverage check
  if (taskId) {
    const taskCheck = findTaskInDag(taskId);
    if (!taskCheck.found) violations.push(`[FW-ENFORCE] Task "${taskId}" not found in Task.DAG.json`);
    else if (taskCheck.status !== "pending" && taskCheck.status !== "in_progress") violations.push(`[FW-ENFORCE] Task "${taskId}" has status "${taskCheck.status}"`);
  }

  // Gate armed check
  const EXECUTION_TOOLS = ["write", "edit", "bash"];
  const BOOTSTRAP_TOOLS = ["compliance_gate_check", "compliance_gate_confirm", "compliance_gate_complete"];
  if (EXECUTION_TOOLS.includes(tool) && !BOOTSTRAP_TOOLS.includes(tool)) {
    const armedCheck = findArmedSession();
    if (!armedCheck.found && mode !== "advisory") violations.push(`[FW-ENFORCE] No armed compliance gate session found (mode: ${mode}).`);
  }
  if (tool === "task" && !BOOTSTRAP_TOOLS.includes(tool)) {
    const anySession = findAnyGateSession();
    if (!anySession.found && mode !== "advisory") violations.push(`[FW-ENFORCE] No active compliance gate session found.`);
  }

  // Write scope check
  if ((tool === "write" || tool === "edit") && agent) {
    const fp = (output.args?.filePath as string) || "";
    if (fp && !isWriteAllowed(agent, fp) && (mode === "strict" || mode === "locked")) {
      violations.push(`[FW-ENFORCE] Agent "${agent}" write to "${fp}" blocked by agent_write_scopes.`);
    }
  }

  // Enforcement mode guard
  if ((mode === "locked" || mode === "strict") && tool === "write" && (output.args?.filePath as string || "").includes(".opencode/project.config.json")) {
    try {
      const newContent = output.args?.content as string;
      if (newContent) {
        const parsed = JSON.parse(newContent);
        const newMode = parsed?.template_resolution?.develop_enforcement_mode || parsed?.template_resolution?.runtime_enforcement_mode;
        if (newMode && newMode !== mode) violations.push(`[FW-ENFORCE] Blocked enforcement_mode change from "${mode}" to "${newMode}".`);
      }
    } catch { /* best-effort */ }
  }

  // TDD enforcement
  if ((tool === "write" || tool === "edit") && taskId) {
    const fp = (output.args?.filePath as string) || "";
    if (fp && isSourceFile(fp) && !fp.includes("test/") && !fp.includes("__tests__/") && !fp.includes(".spec.") && !fp.includes(".test.")) {
      const msg = `[FW-ENFORCE] TDD violation: writing to "${fp}" without prior test changes`;
      if (mode === "advisory") logAuditEntry({ event: "tdd_violation_advisory", message: msg });
      else violations.push(msg);
    }
  }

  // Dangerous bash command audit
  if (tool === "bash") {
    const cmd = (output.args?.command as string) || "";
    if (/rm\s+.*\.opencode|mv\s+.*\.opencode|chmod\s+.*777|>\s*\.opencode|sudo\s+rm/i.test(cmd)) {
      if (mode !== "advisory") violations.push(`[FW-ENFORCE] Dangerous bash command blocked.`);
      else logAuditEntry({ event: "dangerous_bash_advisory", command: cmd.slice(0, 80) });
    }
  }

  // Scope escalation detection
  if ((tool === "write" || tool === "edit") && ((output.args?.filePath as string) || "").includes("project.config.json")) {
    try {
      const oldConfig = readJsonFile<any>(STATE_PATHS.projectConfig());
      const newContent = output.args?.content as string;
      if (newContent) {
        const newConfig = JSON.parse(newContent);
        const oldScopes = oldConfig?.agent_write_scopes || {};
        const newScopes = newConfig.agent_write_scopes || {};
        for (const agentKey of Object.keys(newScopes)) {
          const oldAllowed = oldScopes[agentKey]?.allowed || [];
          const newAllowed = newScopes[agentKey]?.allowed || [];
          if (newAllowed.length > oldAllowed.length) {
            const msg = `[FW-ENFORCE] Scope escalation: "${agentKey}" scopes grew from ${oldAllowed.length} to ${newAllowed.length}`;
            if (mode !== "advisory") violations.push(msg);
            else logAuditEntry({ event: "scope_escalation_advisory", message: msg });
          }
        }
      }
    } catch { /* best-effort */ }
  }

  // Rule registry integrity
  const registryCheck = checkRuleRegistryIntegrity(STATE_PATHS);
  for (const m of registryCheck.mismatches) {
    logAuditEntry({ event: "silent_audit", detail: `[FW-ENFORCE][REGISTRY] Mismatch: ${m.file}${m.error ? " (" + m.error + ")" : ""}` });
  }
  if (!registryCheck.valid && mode !== "advisory") violations.push(`[FW-ENFORCE] Rule registry has ${registryCheck.mismatches.length} mismatches.`);

  // Machine cleanliness
  const machineCheck = checkMachineCleanliness(STATE_PATHS);
  if (!machineCheck.clean && mode !== "advisory") violations.push(`[FW-ENFORCE] Machine.json dirty: ${machineCheck.dirty.join(", ")}`);

  if (violations.length > 0) {
    if (mode === "advisory") { logAuditEntry({ event: "violations_advisory", violations: violations.join("; ") }); return; }
    throw new Error(`Framework enforcement blocked tool "${tool}": ${violations.join("; ")}`);
  }
}

export async function toolExecuteAfter(
  input: { tool: string; sessionID: string; callID: string },
  output: { title: string; output: string; metadata: any; args: any },
): Promise<void> {
  const tool = input.tool;
  const agent = process.env.FRAMEWORK_AGENT || "";
  const taskId = process.env.FRAMEWORK_TASK_ID || "";

  // ── DIAGNOSTIC: Write to filesystem (visible via read) ──
  try {
    const root = process.env.OPENCODE_ROOT || process.cwd();
    fs.appendFileSync(path.join(root, ".task_temp", "_hook_diag.log"),
      `[${new Date().toISOString()}] AFTER HOOK FIRED tool="${tool}" agent="${agent}"\n`);
  } catch { /* best-effort */ }

  /**
   * FW-REPAIR-UC7KS-FILEPATH: Read filePath from output.args, not from
   * process.env.FRAMEWORK_FILE_PATH (which is never set in the codebase).
   * This matches the pattern used in toolExecuteBefore() L92:
   *   const filePath = (output.args?.filePath as string) || "";
   * Without this fix, sections (d) state reconciliation, (e) Write-Time Audit,
   * and (f) knowledge_state auto-sync never execute because filePath is always "".
   *
   * FIXED 2026-06-07 (FW-REPAIR-UC7KS-FILEPATH): Changed from input.args?.filePath
   * to output.args?.filePath to match OpenCode plugin API contract (args live on
   * output in tool.execute.after hook, per uc7ks-enforcer.ts reference and official
   * plugin docs). Also corrected function signature on L462 to include args on output.
   */
  const filePath = (output.args?.filePath as string) || "";

  // ── DIAGNOSTIC: filePath + output.args keys to filesystem ──
  if (tool === "write" || tool === "edit" || tool === "safe_edit") {
    try {
      const root = process.env.OPENCODE_ROOT || process.cwd();
      fs.appendFileSync(path.join(root, ".task_temp", "_hook_diag.log"),
        `[${new Date().toISOString()}] filePath="${filePath}" output.args.keys=[${Object.keys(output.args || {}).join(",") || "NONE"}]\n`);
    } catch { /* best-effort */ }
  }

  // (a) Write audit log entry
  writeAuditLogEntry({
    timestamp: new Date().toISOString(), tool, agent, sessionID: input.sessionID,
    callID: input.callID, taskId, filePath,
    action: tool === "write" || tool === "edit" ? "modify" : "execute",
    result: output?.output !== undefined ? "success" : "completed",
  });

  // (b) Detect stale gate sessions
  try {
    const gate = readJsonFile<any>(STATE_PATHS.gateState());
    if (gate?.sessions) {
      for (const stale of Object.values(gate.sessions).filter(isStaleSession)) {
        writeAuditLogEntry({ event: "stale_session_detected", session_id: (stale as any).session_id, confirmed_at: (stale as any).confirmed_at, hours_stale: ((Date.now() - new Date((stale as any).confirmed_at!).getTime()) / 3600000).toFixed(1) });
      }
    }
  } catch { /* best-effort */ }

  // (c) Auto-drain stale sessions
  const staleResult = checkStaleSessions(STATE_PATHS);
  if (staleResult.count > 0) {
    const drained = autoDrainStaleSessions(STATE_PATHS);
    if (drained > 0) writeAuditLogEntry({ event: "auto_drain", count: drained });
  }

  // (d) Trigger state reconciliation on write/edit
  const mode = getEnforcementMode();
  if ((tool === "write" || tool === "edit") && isSourceFile(filePath) && (mode === "strict" || mode === "locked")) {
    try {
      const machinePath = STATE_PATHS.machine();
      const machine = readJsonFile<any>(machinePath);
      if (machine) {
        machine.eslint_state = machine.eslint_state || { aggregate: { dirty_modules: [] } };
        machine.eslint_state.aggregate.dirty_modules = machine.eslint_state.aggregate.dirty_modules || [];
        fs.writeFileSync(machinePath, JSON.stringify(machine, null, 2));
      }
    } catch { /* best-effort */ }
    process.env.FRAMEWORK_PENDING_FULLSCAN = "true";
  }

  // (e) Auto-trigger Write-Time Audit
  if ((tool === "write" || tool === "edit" || tool === "safe_edit") && filePath) {
    const srcPattern = /\.(ts|tsx|js|jsx|html|scss|prisma)$/;
    const skipPattern = /(\.md$|\.json$|\.yaml$|\.yml$|\.task_temp\/)/;
    if (srcPattern.test(filePath) && !skipPattern.test(filePath)) {
      const now = Date.now();
      if (now - _lastWriteCheckTime > WRITE_CHECK_DEBOUNCE_MS) {
        if (_pendingWriteChecks.length > 0) { _executeWriteAuditCheck(_pendingWriteChecks, agent, taskId); _pendingWriteChecks = []; }
        _lastWriteCheckTime = now;
        _executeWriteAuditCheck([filePath], agent, taskId);
      } else { _pendingWriteChecks.push(filePath); }
    }
  }

  /**
   * (f) UC7KS knowledge_state auto-sync (FW-REPAIR-UC7KS-KNOWLEDGE-STATE)
   *
   * When any file under docs/official_docs/ is written or deleted,
   * recompute total_docs_count and total_size_bytes from index.json
   * and update last_reconciliation timestamp in machine.json.knowledge_state.
   *
   * This closes the gap identified in ARC-KNOWLEDGE-STATE audit:
   *   - toolExecuteAfter previously synced 5 state segments (eslint, type_check,
   *     dependency, format, write_audit) but NEVER touched knowledge_state
   *   - @Knowledge-Curator writes to docs/official_docs/ (updating index.json)
   *     would cause knowledge_state.total_docs_count and total_size_bytes to
   *     diverge from actual cache state
   *   - The janitor_interval_hours config was dead (janitor never auto-triggered),
   *     so knowledge_state.last_janitor_run remained null
   *
   * Design decisions:
   *   - Uses index.json metadata (not filesystem walk) for performance
   *   - Best-effort: errors are silently caught to not block task execution
   *   - Atomic write pattern consistent with other toolExecuteAfter updates
   *   - Does NOT update last_janitor_run (that is janitor.ts's responsibility)
   *
   * @since 2026-06-06 — FW-REPAIR-UC7KS-KNOWLEDGE-STATE
   * @see .task_temp/ARC-KNOWLEDGE-STATE/HANDOVER.md
   */
  if ((tool === "write" || tool === "edit" || tool === "safe_edit" || tool === "safe_delete") &&
      filePath && filePath.includes("docs/official_docs/")) {
    try {
      const _indexPath = path.join(getOpenCodeRoot(), "docs", "official_docs", "index.json");
      if (fs.existsSync(_indexPath)) {
        const manifest = JSON.parse(fs.readFileSync(_indexPath, "utf-8"));
        const _machinePath = STATE_PATHS.machine();
        if (fs.existsSync(_machinePath)) {
          const freshMachine = JSON.parse(fs.readFileSync(_machinePath, "utf-8"));
          freshMachine.knowledge_state = freshMachine.knowledge_state || {};
          freshMachine.knowledge_cache_state = freshMachine.knowledge_cache_state || {};

          const entryCount = (manifest.entries || []).length;

          // Compute total_size_bytes from index.json metadata (no filesystem walk)
          let totalSize = 0;
          for (const entry of (manifest.entries || [])) {
            for (const file of (entry.files || [])) {
              totalSize += file.size_bytes || 0;
            }
          }
          const now = new Date().toISOString();

          /**
           * FW-REPAIR-UNIFY-KNOWLEDGE (2026-06-07): Sync BOTH knowledge_state
           * AND knowledge_cache_state atomically after every docs/official_docs/
           * write or delete.
           *
           * Prior to this fix, only knowledge_state was updated — leaving
           * knowledge_cache_state (used by UC7KS enforcement, pre-execution gates,
           * and framework-self-test Check 28) perpetually stale. This caused
           * total_entries to diverge (stuck at 9 vs actual 13) and
           * pipeline_integrity.verified_count to never update.
           *
           * Design: Single atomic write updating both fields from the same
           * index.json read — no filesystem walk needed. Best-effort (errors
           * silently caught to not block task execution).
           */
          // ── knowledge_state (used by janitor, reconciliation) ──
          freshMachine.knowledge_state.total_docs_count = entryCount;
          freshMachine.knowledge_state.total_size_bytes = totalSize;
          freshMachine.knowledge_state.last_reconciliation = now;

          // ── knowledge_cache_state (used by UC7KS enforcement, self-test) ──
          freshMachine.knowledge_cache_state.total_entries = entryCount;
          if (!freshMachine.knowledge_cache_state.pipeline_integrity) {
            freshMachine.knowledge_cache_state.pipeline_integrity = {};
          }
          freshMachine.knowledge_cache_state.pipeline_integrity.verified_count = entryCount;
          freshMachine.knowledge_cache_state.pipeline_integrity.last_verification_at = now;
          freshMachine.knowledge_cache_state.last_index_check = now;
          freshMachine.knowledge_cache_state.cache_status = "healthy";
          // Ensure compliance object exists (backward compat)
          if (!freshMachine.knowledge_cache_state.compliance) {
            freshMachine.knowledge_cache_state.compliance = {};
          }

          fs.writeFileSync(_machinePath, JSON.stringify(freshMachine, null, 2), "utf-8");
        }
      }
    } catch {
      // Best-effort: knowledge_state sync failure must not block task execution
    }
  }

  // (g) UC7-003: Docs save verification (merged from uc7ks-enforcer.ts)
  // Verifies that files written to docs/official_docs/ actually exist on disk.
  // Best-effort: failures are logged but never block task execution.
  if ((tool === "write" || tool === "edit" || tool === "safe_edit") &&
      filePath && filePath.includes(UC7KS_DOCS_ROOT)) {
    const absPath = path.resolve(getOpenCodeRoot(), filePath);
    try {
      if (fs.existsSync(absPath)) {
        const stat = fs.statSync(absPath);
        console.log(
          `[FW-Enforcer][UC7-003] Doc saved: ${filePath} ` +
          `(${(stat.size / 1024).toFixed(1)}KB). ` +
          `Verify index.json was updated for this file.`
        );
      }
    } catch {
      console.warn(
        `[FW-Enforcer][UC7-003] WARNING: Doc file not found after write: ${filePath}`
      );
    }
  }

  // Orchestrator behavior audit
  if ((agent === "Orchestrator" || agent === "@Orchestrator") && tool !== "task" && tool !== "read" && tool !== "todowrite") {
    logAuditEntry({ event: "orchestrator_violation_attempt", tool, message: `Orchestrator attempted non-scheduling tool "${tool}" and was blocked by DISPATCH GATE` });
  }
}

function _executeWriteAuditCheck(files: string[], agent: string, taskId: string): void {
  const mode = getEnforcementMode();
  const machinePath = STATE_PATHS.machine();
  try {
    const machine = readJsonFile<any>(machinePath);
    if (!machine) return;

    machine.write_audit_state = machine.write_audit_state || { enabled: true, current_session: null, history: [] };
    machine.eslint_state = machine.eslint_state || { aggregate: { dirty_modules: [], total_violations: 0, waived_modules: [] } };
    machine.type_check_state = machine.type_check_state || { status: "clean", dirty_files: [], incremental_errors: 0 };
    machine.dependency_state = machine.dependency_state || { status: "clean", violations: [] };
    machine.format_state = machine.format_state || { status: "clean", unformatted_files: [] };

    const writeAudit = machine.write_audit_state;
    writeAudit.current_session = writeAudit.current_session || { agent, task_id: taskId || "unknown", files_written: [], checks_run: 0, checks_passed: 0, checks_failed: 0, violations_found: 0, violations_resolved: 0, scope_violations_attempted: 0 };
    const session = writeAudit.current_session;

    for (const file of files) {
      if (!/\.(ts|tsx|js|jsx|html|scss|prisma)$/.test(file)) continue;
      if (/\.task_temp\//.test(file)) continue;
      session.files_written.push(file); session.checks_run++;

      const scopeAllowed = isWriteAllowed(agent, file);
      if (!scopeAllowed) {
        session.scope_violations_attempted++; session.checks_failed++; session.violations_found++;
        const msg = `[FW-ENFORCE] Write-Audit: Agent "${agent}" scope violation writing to "${file}"`;
        if (mode === "strict" || mode === "locked") {
          logAuditEntry({ event: "write_audit_scope_blocked", agent, file, mode });
          throw new Error(`${msg} (mode: ${mode}). Revert the change.`);
        }
        logAuditEntry({ event: "write_audit_scope_warning", agent, file, mode });
      } else { session.checks_passed++; }

      const moduleMatch = file.match(/modules\/([^/]+)/);
      const moduleName = moduleMatch ? moduleMatch[1] : file.replace(/\//g, "_");
      if (!machine.eslint_state.modules) machine.eslint_state.modules = {};
      if (!machine.eslint_state.modules[moduleName]) machine.eslint_state.modules[moduleName] = { status: "dirty", violations: [], last_check: new Date().toISOString(), waivers_applied: [] };
      if (!machine.eslint_state.aggregate.dirty_modules.includes(moduleName)) machine.eslint_state.aggregate.dirty_modules.push(moduleName);
      machine.type_check_state.status = "dirty";
      if (!machine.type_check_state.dirty_files.includes(file)) machine.type_check_state.dirty_files.push(file);
      if (!machine.format_state.unformatted_files.includes(file)) { machine.format_state.unformatted_files.push(file); machine.format_state.status = "dirty"; }
      if (!machine.dependency_state.violations.some((v: any) => v.file === file)) machine.dependency_state.violations.push({ file, message: "pending depcruiser check", severity: "info" });
    }

    fs.writeFileSync(machinePath, JSON.stringify(machine, null, 2));

    // Attempt full quality checks via code-quality-lib
    try {
      const _require = createRequire(import.meta.url);
      const cql = _require("../../scripts/mcp-tools/code-quality-lib.js");
      const projectRoot = path.resolve(getOpenCodeRoot(), (readJsonFile<any>(STATE_PATHS.projectConfig())?.project_root || "."));
      const results = cql.runAllChecks(files[files.length - 1], projectRoot, agent, taskId, { auto_fix: mode !== "locked", skip_checks: [] });
      const updatedMachine = readJsonFile<any>(machinePath);
      if (updatedMachine) {
        updatedMachine.write_audit_state.current_session = session;
        if (results.checks.eslint?.pass) {
          const m = updatedMachine.eslint_state;
          if (m?.aggregate?.dirty_modules) {
            m.aggregate.dirty_modules = m.aggregate.dirty_modules.filter((d: string) => d !== moduleName);
          }
        }
        fs.writeFileSync(machinePath, JSON.stringify(updatedMachine, null, 2));
      }
    } catch { /* code-quality-lib not available */ }
  } catch (err: any) {
    if (err.message?.includes("scope violation")) throw err;
    try { logAuditEntry({ event: "write_audit_error", error: err.message?.slice(0, 200) }); } catch { /* silent */ }
  }
}

// tool-scope-guard.ts — S4: + readDispatchAllowedTools
import * as fs from "node:fs";
import { readJsonFile } from "../lib/gate-core";
import { STATE_PATHS } from "../lib/state-utils";

fs.writeFileSync("/tmp/tool-scope-loaded.txt", `${new Date().toISOString()} loaded\n`, "utf8");

function isModifyTool(tool: string): boolean {
  return tool === "write" || tool === "edit" || tool === "safe_edit" || tool === "safe_mkdir" || tool === "safe_delete" || tool === "safe_shell";
}

function getModifyPath(args: Record<string, unknown>): string {
  return (args?.filePath || args?.dirPath || args?.command || "") as string;
}

function isModifyShell(args: Record<string, unknown>): boolean {
  return /^(cp|mv|rm)\b/.test((args?.command || "") as string);
}

function readDispatchAllowedTools(agent: string): string[] | "*" {
  fs.appendFileSync("/tmp/ts-readDispatch.log", `[${new Date().toISOString()}] enter | agent=${agent}\n`, "utf8");
  const FALLBACK = ["task","read","todowrite","compliance_gate_check","compliance_gate_confirm","compliance_gate_complete","dispatch_subagent"];
  try {
    const cfg = readJsonFile<any>(STATE_PATHS.projectConfig());
    const tools = cfg?.agent_dispatch_allowed_tools;
    if (!tools || typeof tools !== "object") { fs.appendFileSync("/tmp/ts-readDispatch.log", `[${new Date().toISOString()}] exit (fallback: no tools config)\n`, "utf8"); return FALLBACK; }
    const atForm = agent.startsWith("@") ? agent : "@" + agent;
    const plainForm = agent.replace(/^@/, "");
    const entry = tools[atForm] || tools[plainForm];
    if (!entry) { fs.appendFileSync("/tmp/ts-readDispatch.log", `[${new Date().toISOString()}] exit (fallback: no entry)\n`, "utf8"); return FALLBACK; }
    if (entry === "*" || (Array.isArray(entry) && entry.length === 1 && entry[0] === "*")) { fs.appendFileSync("/tmp/ts-readDispatch.log", `[${new Date().toISOString()}] exit (wildcard)\n`, "utf8"); return "*"; }
    if (Array.isArray(entry)) { fs.appendFileSync("/tmp/ts-readDispatch.log", `[${new Date().toISOString()}] exit (list) count=${entry.length}\n`, "utf8"); return entry; }
    fs.appendFileSync("/tmp/ts-readDispatch.log", `[${new Date().toISOString()}] exit (fallback: invalid)\n`, "utf8");
    return FALLBACK;
  } catch (e: any) {
    fs.appendFileSync("/tmp/ts-readDispatch.log", `[${new Date().toISOString()}] exit (error) | ${e.message}\n`, "utf8");
    return FALLBACK;
  }
}

export default (async (_ctx: any) => {
  fs.writeFileSync("/tmp/tool-scope-hooks.txt", `${new Date().toISOString()} hooks registered\n`, "utf8");
  return {};
}) as any;

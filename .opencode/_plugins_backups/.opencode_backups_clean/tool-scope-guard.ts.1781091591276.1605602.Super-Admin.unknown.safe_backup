// tool-scope-guard.ts — S3: + getModifyPath + isModifyShell
import * as fs from "node:fs";

fs.writeFileSync("/tmp/tool-scope-loaded.txt", `${new Date().toISOString()} loaded\n`, "utf8");

function isModifyTool(tool: string): boolean {
  const result = tool === "write" || tool === "edit" || tool === "safe_edit" || tool === "safe_mkdir" || tool === "safe_delete" || tool === "safe_shell";
  return result;
}

function getModifyPath(args: Record<string, unknown>): string {
  const p = (args?.filePath || args?.dirPath || args?.command || "") as string;
  fs.appendFileSync("/tmp/ts-getModifyPath.log", `[${new Date().toISOString()}] path=${p}\n`, "utf8");
  return p;
}

function isModifyShell(args: Record<string, unknown>): boolean {
  const cmd = (args?.command || "") as string;
  const result = /^(cp|mv|rm)\b/.test(cmd);
  fs.appendFileSync("/tmp/ts-isModifyShell.log", `[${new Date().toISOString()}] cmd=${cmd.substring(0,30)} result=${result}\n`, "utf8");
  return result;
}

export default (async (_ctx: any) => {
  fs.writeFileSync("/tmp/tool-scope-hooks.txt", `${new Date().toISOString()} hooks registered\n`, "utf8");
  return {};
}) as any;

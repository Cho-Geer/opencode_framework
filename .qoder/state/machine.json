  "stateTransitions": {
    "task": {
      "Idle": [
        "Ready"
      ],
      "Ready": [
        "InProgress"
      ],
      "InProgress": [
        "Testing",
        "Blocked"
      ],
      "Testing": [
        "Review",
        "InProgress"
      ],
      "Review": [
        "Done",
        "InProgress"
      ],
      "Blocked": [
        "InProgress"
      ]
    }
  },
  "taskLifecycle": {
    "taskTypes": [
      "backend",
      "frontend",
      "devops",
      "test"
    ],
    "states": [
      "Idle",
      "Ready",
      "InProgress",
      "Testing",
      "Review",
      "Done",
      "Blocked"
    ],
    "taskStateFilePattern": "Task.DAG.json",
    "transitions": [
      {
        "from": "InProgress",
        "to": "Testing",
        "requiredEvidence": [
          {
            "filePattern": "tasks/{taskId}/TASK_LOG.md",
            "description": "工作记忆草稿纸，记录本次修改计划"
          }
        ]
      },
      {
        "from": "Testing",
        "to": "Review",
        "requiredEvidence": [
          {
            "filePattern": "tasks/{taskId}/test_report.json",
            "description": "测试执行报告",
            "schema": {
              "$schema": "http://json-schema.org/draft-07/schema#",
              "type": "object",
              "required": [
                "execution_evidence",
                "coverage"
              ],
              "properties": {
                "execution_evidence": {
                  "type": "object",
                  "required": [
                    "exit_code",
                    "output_summary"
                  ],
                  "properties": {
                    "exit_code": {
                      "type": "integer",
                      "description": "测试进程退出码，0 表示全部通过"
                    },
                    "output_summary": {
                      "type": "string",
                      "description": "测试执行输出摘要"
                    }
                  }
                },
                "coverage": {
                  "type": "object",
                  "properties": {
                    "lines": {
                      "type": "number",
                      "minimum": 70,
                      "description": "行覆盖率（%），最低 70%"
                    },
                    "branches": {
                      "type": "number",
                      "description": "分支覆盖率（%）"
                    },
                    "functions": {
                      "type": "number",
                      "description": "函数覆盖率（%）"
                    },
                    "statements": {
                      "type": "number",
                      "description": "语句覆盖率（%）"
                    }
                  }
                }
              },
              "additionalProperties": true
            },
            "contentMustNotContain": "\"failed\": [1-9]"
          }
        ]
      },
      {
        "from": "Review",
        "to": "Done",
        "requiredEvidence": [
          {
            "filePattern": "tasks/{taskId}/guardian_report.md",
            "description": "@Guardian 审查报告",
            "contentMustContain": "PASS",
            "contentMustNotContain": "FAIL"
          }
        ]
      },
      {
        "from": "Testing",
        "to": "InProgress",
        "requiredEvidence": [
          {
            "filePattern": "tasks/{taskId}/test_report.json",
            "description": "测试执行报告（失败时回退）",
            "contentMustContain": "\"exit_code\": 1"
          }
        ]
      },
      {
        "from": "Review",
        "to": "InProgress",
        "requiredEvidence": [
          {
            "filePattern": "tasks/{taskId}/guardian_report.md",
            "description": "@Guardian 审查报告（未通过时回退）",
            "contentMustContain": "FAIL"
          }
        ]
      }
    ]
  },

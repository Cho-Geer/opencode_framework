  "stateTransitions": {
    "task": {
      "Idle": [
        "Ready"
      ],
      "Ready": [
        "InProgress"
      ],
      "InProgress": [
        "Testing",
        "Blocked"
      ],
      "Testing": [
        "Review",
        "InProgress"
      ],
      "Review": [
        "Done",
        "InProgress"
      ],
      "Blocked": [
        "InProgress"
      ]
    }
  },
  "taskLifecycle": {
    "taskTypes": [
      "backend",
      "frontend",
      "devops",
      "test"
    ],
    "states": [
      "Idle",
      "Ready",
      "InProgress",
      "Testing",
      "Review",
      "Done",
      "Blocked"
    ],
    "taskStateFilePattern": "Task.DAG.json",
    "transitions": [
      {
        "from": "InProgress",
        "to": "Testing",
        "requiredEvidence": [
          {
            "filePattern": "tasks/{taskId}/TASK_LOG.md",
            "description": "工作记忆草稿纸，记录本次修改计划"
          }
        ]
      },
      {
        "from": "Testing",
        "to": "Review",
        "requiredEvidence": [
          {
            "filePattern": "tasks/{taskId}/test_report.json",
            "description": "测试执行报告",
            "schema": {
              "requiredFields": [
                "execution_evidence",
                "coverage"
              ],
              "execution_evidence": {
                "requiredFields": [
                  "exit_code",
                  "output_summary"
                ]
              },
              "coverage": {
                "minThreshold": 70
              }
            },
            "contentMustNotContain": "\"failed\": [1-9]"
          }
        ]
      },
      {
        "from": "Review",
        "to": "Done",
        "requiredEvidence": [
          {
            "filePattern": "tasks/{taskId}/guardian_report.md",
            "description": "@Guardian 审查报告",
            "contentMustContain": "PASS",
            "contentMustNotContain": "FAIL"
          }
        ]
      },
      {
        "from": "Testing",
        "to": "InProgress",
        "requiredEvidence": [
          {
            "filePattern": "tasks/{taskId}/test_report.json",
            "description": "测试执行报告（失败时回退）",
            "contentMustContain": "\"exit_code\": 1"
          }
        ]
      },
      {
        "from": "Review",
        "to": "InProgress",
        "requiredEvidence": [
          {
            "filePattern": "tasks/{taskId}/guardian_report.md",
            "description": "@Guardian 审查报告（未通过时回退）",
            "contentMustContain": "FAIL"
          }
        ]
      }
    ]
  },

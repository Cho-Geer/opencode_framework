{
  "mcpServers": {
    "workbuddy-compliance-gate": {
      "command": "node",
      "args": ["./.workbuddy/mcp/compliance-gate.js"],
      "env": {
        "WORKBUDDY_ROOT": "."
      },
      "disabled": false
    },
    "workbuddy-code-quality-gate": {
      "command": "node",
      "args": ["./.workbuddy/mcp/code-quality-gate.js"],
      "env": {
        "WORKBUDDY_ROOT": "."
      },
      "disabled": false
    },
    "workbuddy-eslint-audit": {
      "command": "node",
      "args": ["./.workbuddy/mcp/eslint-audit.js"],
      "env": {
        "WORKBUDDY_ROOT": "."
      },
      "disabled": false
    },
    "workbuddy-keystone-validate": {
      "command": "node",
      "args": ["./.workbuddy/mcp/keystone-validate.js"],
      "env": {
        "WORKBUDDY_ROOT": "."
      },
      "disabled": false
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "env": {
        "DEFAULT_MINIMUM_TOKENS": "10000"
      },
      "disabled": false
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "disabled": false
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "disabled": false
    },
    "Salesforce DX": {
      "command": "npx",
      "args": [
        "-y",
        "@salesforce/mcp",
        "--orgs", "DEFAULT_TARGET_ORG",
        "--toolsets", "testing,core,orgs,metadata,data,users,aura-experts,code-analysis,enrichment,experts-validation,lwc-experts,mobile,mobile-core,scale-products",
        "--tools", "run_apex_test",
        "--allow-non-ga-tools"
      ],
      "timeout": 60000,
      "disabled": false
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "${POSTGRES_URL}"],
      "disabled": false
    },
    "docker": {
      "command": "uvx",
      "args": ["mcp-server-docker"],
      "disabled": false
    },
    "pandoc": {
      "command": "uvx",
      "args": ["mcp-pandoc"],
      "disabled": false
    },
    "excel": {
      "command": "npx",
      "args": ["--yes", "@negokaz/excel-mcp-server"],
      "env": {
        "EXCEL_MCP_PAGING_CELLS_LIMIT": "1000000"
      },
      "disabled": false
    }
  }
}

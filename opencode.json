{
  "$schema": "https://opencode.ai/config.json",
  "_comment": "OpenCode Framework Adapter — DO NOT compete with Task.DAG.json, machine.json, gate-state.json, or contract.yaml as authorities. This file mirrors existing agent configurations and enforces permissions.",
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/**/*.md",
    ".opencode/rules/rule_detail/*.md"
  ],
  "agents": {
    "Meta-Planner": {
      "mode": "primary",
      "model": "DeepSeek/deepseek-v4-pro",
      "prompt": ".opencode/agents/meta-planner.md",
      "permission": {
        "write": {
          "allow": [
            ".task_temp/**",
            "Task.DAG.json",
            "Project.graph"
          ],
          "deny": [
            "booking_system_refactor/booking-backend/src/**",
            "booking_system_refactor/booking-frontend/src/**",
            ".opencode/tools/**",
            ".opencode/scripts/**",
            ".opencode/state/**",
            "contract.yaml"
          ]
        },
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "Orchestrator": {
      "mode": "primary",
      "model": "DeepSeek/deepseek-v4-flash",
      "prompt": ".opencode/agents/orchestrator.md",
      "permission": {
        "write": {
          "allow": [
            ".task_temp/**",
            "Task.DAG.json"
          ],
          "deny": [
            "booking_system_refactor/booking-backend/src/**",
            "booking_system_refactor/booking-frontend/src/**",
            "contract.yaml",
            ".opencode/tools/**",
            ".opencode/scripts/**"
          ]
        },
        "tools": {
          "read": "deny",
          "grep": "deny",
          "glob": "deny",
          "webfetch": "deny"
        },
        "bash": {
          "git *": "ask"
        }
      }
    },
    "Architect": {
      "mode": "primary",
      "model": "DeepSeek/deepseek-v4-pro",
      "prompt": ".opencode/agents/architect.md",
      "permission": {
        "write": {
          "allow": [
            ".opencode/state/**",
            "contract.yaml",
            ".task_temp/**",
            ".opencode/project.config.json",
            "PROJECT_REFERENCE.md",
            ".opencode/context/**",
            ".opencode/rules/**",
            ".opencode/agents/**",
            ".opencode/subagent-preamble.md",
            ".opencode/scripts/**"
          ],
          "deny": [
            "booking_system_refactor/booking-backend/src/**",
            "booking_system_refactor/booking-frontend/src/**",
            "booking_system_refactor/booking-backend/test/**"
          ]
        }
      }
    },
    "Coder-BE": {
      "mode": "subagent",
      "model": "DeepSeek/deepseek-v4-flash",
      "prompt": ".opencode/agents/coder-be.md",
      "permission": {
        "write": {
          "allow": [
            "booking_system_refactor/booking-backend/src/**",
            "booking_system_refactor/booking-backend/test/**",
            "booking_system_refactor/booking-backend/prisma/**",
            "booking_system_refactor/booking-backend/*.{json,js,ts}",
            ".opencode/scripts/__tests__/**",
            ".task_temp/**",
            "contract.yaml"
          ],
          "deny": [
            "booking_system_refactor/booking-frontend/**",
            ".opencode/agents/**",
            ".opencode/rules/**",
            ".opencode/tools/**",
            ".opencode/state/**",
            ".opencode/scripts/mcp-tools/**",
            ".opencode/scripts/command-tools/**",
            "AGENTS.md",
            "PROJECT_REFERENCE.md",
            "TECH_DEBT_REGISTRY.md"
          ]
        },
        "bash": "allow"
      }
    },
    "Coder-FE": {
      "mode": "subagent",
      "model": "DeepSeek/deepseek-v4-flash",
      "prompt": ".opencode/agents/coder-fe.md",
      "permission": {
        "write": {
          "allow": [
            "booking_system_refactor/booking-frontend/**",
            ".task_temp/**",
            "contract.yaml"
          ],
          "deny": [
            "booking_system_refactor/booking-backend/**",
            ".opencode/agents/**",
            ".opencode/rules/**",
            ".opencode/tools/**",
            ".opencode/state/**",
            ".opencode/scripts/**",
            "AGENTS.md",
            "PROJECT_REFERENCE.md",
            "TECH_DEBT_REGISTRY.md"
          ]
        },
        "bash": "allow"
      }
    },
    "Guardian": {
      "mode": "subagent",
      "model": "DeepSeek/deepseek-v4-flash",
      "prompt": ".opencode/agents/guardian.md",
      "permission": {
        "write": {
          "allow": [
            ".task_temp/**"
          ],
          "deny": [
            "booking_system_refactor/booking-backend/src/**",
            "booking_system_refactor/booking-frontend/src/**",
            "contract.yaml",
            ".opencode/**",
            "AGENTS.md",
            "PROJECT_REFERENCE.md"
          ]
        },
        "read": "allow",
        "bash": {
          "grep *": "allow",
          "git log*": "allow"
        }
      }
    },
    "Arbiter": {
      "mode": "subagent",
      "model": "DeepSeek/deepseek-v4-pro",
      "prompt": ".opencode/agents/arbiter.md",
      "permission": {
        "write": {
          "allow": [
            ".task_temp/**",
            "WAIVE.md",
            "TECH_DEBT_REGISTRY.md"
          ],
          "deny": [
            "booking_system_refactor/booking-backend/src/**",
            "booking_system_refactor/booking-frontend/src/**",
            "contract.yaml",
            ".opencode/tools/**",
            ".opencode/scripts/**"
          ]
        }
      }
    },
    "CI-CD-Agent": {
      "mode": "subagent",
      "model": "DeepSeek/deepseek-v4-pro",
      "prompt": ".opencode/agents/ci-cd-agent.md",
      "permission": {
        "write": {
          "allow": [
            "docker-compose*.yml",
            ".github/workflows/**",
            "Dockerfile*",
            ".env.*",
            "booking_system_refactor/booking-backend/prisma/**",
            ".task_temp/**"
          ],
          "deny": [
            "booking_system_refactor/booking-backend/src/**",
            "booking_system_refactor/booking-frontend/src/**",
            ".opencode/agents/**",
            ".opencode/rules/**"
          ]
        },
        "bash": {
          "docker *": "allow",
          "gh *": "allow",
          "git push": "ask"
        }
      }
    }
  },
  "plugin": [".opencode/plugins/framework-enforcer"],
  "mcp": {},
  "_framework_authorities": {
    "description": "This opencode.json is an ADAPTER — it reflects/mirrors existing framework authorities without overriding them. The following remain the single source of truth:",
    "dag_authority": "Task.DAG.json",
    "state_authorities": ["machine.json", "gate-state.json"],
    "contract_authority": "contract.yaml",
    "agent_definitions": ".opencode/agents/*.md (canonical, opencode.json mirrors only)"
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/**/*.md",
    ".opencode/rules/rule_detail/*.md"
  ],
  "lsp": true,
  "agent": {
    "Meta-Planner": {
      "mode": "subagent",
      "model": "DeepSeek/deepseek-v4-pro",
      "prompt": ".opencode/agents/meta-planner.md",
      "permission": {
        "read": "allow",
        "edit": {
          ".task_temp/**": "allow",
          "Task.DAG.json": "allow",
          "Project.graph": "allow",
          "booking_system_refactor/booking-backend/src/**": "deny",
          "booking_system_refactor/booking-frontend/src/**": "deny",
          ".opencode/tools/**": "deny",
          ".opencode/scripts/**": "deny",
          ".opencode/state/**": "deny",
          "contract.yaml": "deny",
          "*": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "bash": "ask"
      }
    },
    "Orchestrator": {
      "mode": "primary",
      "model": "DeepSeek/deepseek-v4-flash",
      "prompt": ".opencode/agents/orchestrator.md",
      "permission": {
        "read": "deny",
        "edit": {
          ".task_temp/**": "allow",
          "Task.DAG.json": "allow",
          "booking_system_refactor/booking-backend/src/**": "deny",
          "booking_system_refactor/booking-frontend/src/**": "deny",
          "contract.yaml": "deny",
          ".opencode/tools/**": "deny",
          ".opencode/scripts/**": "deny",
          "*": "deny"
        },
        "glob": "deny",
        "grep": "deny",
        "webfetch": "deny",
        "bash": {
          "git *": "ask"
        }
      }
    },
    "Architect": {
      "mode": "subagent",
      "model": "DeepSeek/deepseek-v4-pro",
      "prompt": ".opencode/agents/architect.md",
      "permission": {
        "read": "allow",
        "edit": {
          "opencode.json": "allow",
          ".opencode/state/**": "allow",
          "contract.yaml": "allow",
          ".task_temp/**": "allow",
          ".opencode/project.config.json": "allow",
          "PROJECT_REFERENCE.md": "allow",
          ".opencode/context/**": "allow",
          ".opencode/rules/**": "allow",
          ".opencode/agents/**": "allow",
          ".opencode/subagent-preamble.md": "allow",
          ".opencode/scripts/**": "allow",
          "booking_system_refactor/booking-backend/src/**": "deny",
          "booking_system_refactor/booking-frontend/src/**": "deny",
          "booking_system_refactor/booking-backend/test/**": "deny",
          "*": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "bash": "ask"
      }
    },
    "Coder-BE": {
      "mode": "subagent",
      "model": "DeepSeek/deepseek-v4-flash",
      "prompt": ".opencode/agents/coder-be.md",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "safe_edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow"
      }
    },
    "Coder-FE": {
      "mode": "subagent",
      "model": "DeepSeek/deepseek-v4-flash",
      "prompt": ".opencode/agents/coder-fe.md",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "safe_edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow"
      }
    },
    "Guardian": {
      "mode": "subagent",
      "model": "DeepSeek/deepseek-v4-flash",
      "prompt": ".opencode/agents/guardian.md",
      "permission": {
        "read": "allow",
        "edit": {
          ".task_temp/**": "allow",
          "booking_system_refactor/booking-backend/src/**": "deny",
          "booking_system_refactor/booking-frontend/src/**": "deny",
          "contract.yaml": "deny",
          ".opencode/**": "deny",
          "AGENTS.md": "deny",
          "PROJECT_REFERENCE.md": "deny",
          "*": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "bash": {
          "grep *": "allow",
          "git log*": "allow"
        }
      }
    },
    "Arbiter": {
      "mode": "subagent",
      "model": "DeepSeek/deepseek-v4-pro",
      "prompt": ".opencode/agents/arbiter.md",
      "permission": {
        "read": "allow",
        "edit": {
          ".task_temp/**": "allow",
          "WAIVE.md": "allow",
          "TECH_DEBT_REGISTRY.md": "allow",
          "booking_system_refactor/booking-backend/src/**": "deny",
          "booking_system_refactor/booking-frontend/src/**": "deny",
          "contract.yaml": "deny",
          ".opencode/tools/**": "deny",
          ".opencode/scripts/**": "deny",
          "*": "deny"
        },
        "glob": "allow",
        "grep": "allow"
      }
    },
    "CI-CD-Agent": {
      "mode": "subagent",
      "model": "DeepSeek/deepseek-v4-pro",
      "prompt": ".opencode/agents/ci-cd-agent.md",
      "permission": {
        "read": "allow",
        "edit": {
          "docker-compose*.yml": "allow",
          ".github/workflows/**": "allow",
          "Dockerfile*": "allow",
          ".env.*": "allow",
          "booking_system_refactor/booking-backend/prisma/**": "allow",
          ".task_temp/**": "allow",
          "booking_system_refactor/booking-backend/src/**": "deny",
          "booking_system_refactor/booking-frontend/src/**": "deny",
          ".opencode/agents/**": "deny",
          ".opencode/rules/**": "deny",
          "*": "deny"
        },
        "bash": {
          "docker *": "allow",
          "gh *": "allow",
          "git push": "ask"
        }
      }
    }
  },
  "plugin": [
    ".opencode/plugins/framework-enforcer"
  ],
  "mcp": {}
}

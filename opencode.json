          "docs/official_docs/.metadata/**": "allow",
          "booking_system_refactor/**": "deny",
          ".opencode/**": "deny"
        },
        "safe_shell": {
          "mkdir *docs/official_docs*": "allow",
          "node .opencode/scripts/knowledge/*": "allow",
          "npm *": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "wc *": "allow",
          "head *": "allow",
          "tail *": "allow"
        },
        "safe_mkdir": {
          "docs/official_docs/**": "allow",
          "booking_system_refactor/**": "deny",
          ".opencode/**": "deny"
        },
        "safe_delete": {
          "docs/official_docs/**": "allow",
          "docs/official_docs/.metadata/**": "allow",
          "booking_system_refactor/**": "deny",
          ".opencode/**": "deny"
        },
        "safe_diff": {
          "docs/official_docs/**": "allow"
        }
      }
    }
  },
  "plugin": [
    ".opencode/plugins/framework-enforcer",
    ".opencode/plugins/uc7ks-enforcer"
  ],
  "mcp": {
    "compliance-gate": {
      "type": "local",
      "command": [
        "node",
        "./.opencode/scripts/mcp-tools/compliance-gate.js"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "eslint-audit": {
      "type": "local",
      "command": [
        "node",
        "./.opencode/scripts/mcp-tools/eslint-audit.js"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "enabled": true,
      "environment": {
        "DEFAULT_MINIMUM_TOKENS": "10000"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "postgre_sql": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "{env:POSTGRES_CONNECTION_STRING}"
      ]
    },
    "docker": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "mcp-server-docker"
      ]
    },
    "pandoc": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "mcp-pandoc"
      ]
    },
    "excel": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "--yes",
        "@negokaz/excel-mcp-server"
      ],
      "environment": {
        "EXCEL_MCP_PAGING_CELLS_LIMIT": "1000000"
      }
    }
  }
}

  "experimental": {
    "policies": [
      {
        "effect": "deny",
        "action": "provider.use",
        "resource": "openai"
      },
      {
        "effect": "allow",
        "action": "provider.use",
        "resource": "anthropic"
      },
      {
        "effect": "allow",
        "action": "provider.use",
        "resource": "deepseek"
      }
    ]
  },
  "plugin": [
    "./.opencode/plugins/before-dispatcher.ts",
    "./.opencode/plugins/after-dispatcher.ts",
    "./.opencode/plugins/system-dispatcher.ts",
    "./.opencode/plugins/session.ts",
    "./.opencode/plugins/tool-def-trimmer.ts"
  ],
  "mcp": {
    "compliance-gate": {
      "type": "local",
      "command": [
        "/home/zhaoge/.bun/bin/bun",
        "./.opencode/scripts/mcp-tools/compliance-gate.ts"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "eslint-audit": {
      "type": "local",
      "command": [
        "/home/zhaoge/.bun/bin/bun",
        "./.opencode/scripts/mcp-tools/eslint-audit.ts"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "code-quality-check": {
      "type": "local",
      "command": [
        "/home/zhaoge/.bun/bin/bun",
        "./.opencode/scripts/mcp-tools/code-quality-check.ts"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "enabled": true,
      "environment": {
        "DEFAULT_MINIMUM_TOKENS": "10000"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "postgre_sql": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "{env:POSTGRES_CONNECTION_STRING}"
      ]
    },
    "docker": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "mcp-server-docker"
      ]
    },
    "pandoc": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "mcp-pandoc"
      ]
    },
    "excel": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "--yes",
        "@negokaz/excel-mcp-server"
      ],
      "environment": {
        "EXCEL_MCP_PAGING_CELLS_LIMIT": "1000000"
      }
    },
    "codegraph": {
      "type": "local",
      "command": [
        "/home/zhaoge/.local/bin/codegraph",
        "serve",
        "--mcp",
        "--path",
        "."
      ],
      "timeout": 30000,
      "enabled": true
    },
    "notify-server": {
      "type": "local",
      "command": [
        "/home/zhaoge/.bun/bin/bun",
        "./.opencode/scripts/mcp-tools/notify-server.ts"
      ],
      "timeout": 30000,
      "enabled": true
    }
  }
}

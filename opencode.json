{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/common/**/*.md",
    ".opencode/rules/rule_detail/**/*.md",
    ".opencode/rules/coding/**/*.md"
  ],
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },
  "default_agent": "Orchestrator",
  "agent": {
    "Orchestrator": {
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "prompt": ".opencode/agents/Orchestrator.md",
      "variant": "max",
      "permission": {
        "task": "allow",
        "question": "allow",
        "todowrite": "allow",
        "context7": "deny",
        "skill": "allow",
        "resolve_domain_id": "allow",
        "checklist_status": "allow",
        "advance_checklist_phase": "allow",
        "compliance_gate_check": "allow",
        "compliance_gate_confirm": "allow",
        "compliance_gate_complete": "allow",
        "compliance_gate_drain_stale": "allow",
        "compliance_gate_purge": "allow",
        "compliance_gate_retry_confirm": "allow",
        "dispatch_subagent": "allow",
        "confirm_repo_grant": "allow",
        "safe_diff": "allow",
        "safe_edit": {
          ".task_temp/**": "allow",
          "docs/review/**": "allow",
          "Task.DAG.json": "deny",
          ".opencode/**": "deny",
          "*": "deny"
        },
        "safe_delete": {
          ".task_temp/**": "allow",
          "docs/review/**": "allow",
          "*": "deny"
        },
        "safe_mkdir": {
          ".task_temp/**": "allow",
          "docs/review/**": "allow",
          "*": "deny"
        },
        "safe_hash": "allow",
        "safe_test": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "edit": "deny",
        "bash": "deny",
        "glob": "deny",
        "grep": "deny",
        "safe_shell": {
          "node -e *": "deny",
          "node *.ts *": "deny",
          "node *.js *": "deny",
          "echo *": "allow",
          "cat *": "allow",
          "ls *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "which *": "allow",
          "cd *": "allow",
          "sha256sum *": "allow",
          "npm run *": "deny",
          "npx *": "deny",
          "bun *": "deny",
          "git *": "deny",
          "rm *": "deny",
          "docker *": "deny",
          "cp * *": "deny",
          "mv * *": "deny",
          "mkdir -p *": "deny"
        },
        "read": {
          "Task.DAG.json": "allow",
          ".opencode/project.config.json": "allow",
          "opencode.json": "allow",
          ".opencode/state/*.json": "allow",
          ".task_temp/**": "allow",
          "docs/official_docs/**": "allow",
          "docs/review/**": "allow",
          ".opencode/agents/Orchestrator.md": "allow",
          ".opencode/legacy/agent-profiles/*.md": "allow"
        },
        "safe_restore": {
          ".task_temp/**": "allow",
          "docs/review/**": "allow",
          "Task.DAG.json": "deny",
          ".opencode/**": "deny",
          "*": "deny"
        },
        "acp_notify": "allow",
        "config_read_attest": "allow",
        "skill_read_attest": "allow",
        "rule_read_attest": "allow",
        "safe_repo_status": "allow",
        "safe_repo_diff": "allow",
        "safe_repo_log": "allow",
        "safe_repo_show": "allow",
        "safe_repo_branch": "allow"
      }
    },
    "build": {
      "native": true,
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
